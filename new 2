	private boolean tryInput(By by, String val) {
		try {
			WebElement el = findElementIsDisplayed(by, true, 1200);
			return tryInput(el, val);
		} catch (Exception e) {
			return false;
		}
	}
	private boolean tryInput(WebElement el, String val) {
		try {
			if (el == null) return false;
			safeScrollIntoView(el);
			el.clear();
			el.sendKeys(val);
			return true;
		} catch (Exception e) { return false; }
	}

	private WebElement findFirstPresent(By[] candidates, int eachTimeoutMs) {
	    for (By by : candidates) {
	        try {
	            WebElement el = findElementIsDisplayed(by, true, eachTimeoutMs);
	            if (el != null) return el;
	        } catch (Exception ignore) {}
	    }
	    return null;
	}

	private void inputByCandidates(By[] cands, String val) {
		WebElement el = findFirstPresent(cands, 800);
		if (el != null) tryInput(el, val);
	}
