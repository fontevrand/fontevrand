// 收費管道(限變更為自行繳費) - 第一頁驗證與挑選
public class CSRPaymentChannel extends AbstractBasePage {

	// ====== 既有/原本 ======
	private By eServiceBtnLocator = By.xpath("//div[@class='modal-body']/button[@id='E']");
	private By confirmBtnLocator = By
			.xpath("//div[@class='modal-footer']/div[@class='btn-area']/button[@id='checkSelected']");
	private By paymentChannelConfirmBtnLocator = By.xpath(
			"(//div[contains(@class, 'modal-content')]//p[@id='messageBoxText' and contains(text(), '提醒您，執行【收費管道變更】作業後，系統需作業時間，若您欲使用【行動繳費】方式，請於次二個工作日再登入使用。')]/following::button[contains(text(), '確定') and contains(@class, 'btn red xs')])[1]");
	private By paymentMethodPageTitleLocator = By
			.xpath("//div[@class='redTag' and @id='red_tag' and contains(text(),'收費管道(限變更為自行繳費)')]");
	private By policyWithChangeAuthorityTblTitleLocator = By.xpath("//div[@class='subTitle' and text()='有異動權限保單']");
	private By policyWithoutChangeAuthorityTblTitleLocator = By.xpath("//div[@class='subTitle' and text()='無異動權限保單']");
	private By goUpButton = By.xpath("//div[@class='sidebar']//div[@class='hidden-mobile']//a[@class='gotop js-gotop']");

	// ====== 有異動權限保單 (With-Change) 區塊 ======
	private By withTblPcLocator = By.xpath(
			"//div[@class='subTitle' and text()='有異動權限保單']/following-sibling::div[contains(@class,'tb_Table_pc')][1]");
	private By withTblPcHeaderCells = By.xpath(
			"//div[@class='subTitle' and text()='有異動權限保單']/following-sibling::div[contains(@class,'tb_Table_pc')][1]//div[contains(@class,'headeRow')]//div[contains(@class,'tb_column')]");
	private By withTblPcRows = By.xpath(
			"//div[@class='subTitle' and text()='有異動權限保單']/following-sibling::div[contains(@class,'tb_Table_pc')][1]//div[contains(@class,'tb_row') and not(contains(@class,'headeRow'))]");
	private By withTblPcSelectCbs = By.xpath(
			"//div[@class='subTitle' and text()='有異動權限保單']/following-sibling::div[contains(@class,'tb_Table_pc')][1]//input[@type='checkbox' and @name='list_pc']");
	private By withTblPcPolicyLinks = By.xpath(
			"//div[@class='subTitle' and text()='有異動權限保單']/following-sibling::div[contains(@class,'tb_Table_pc')][1]//div[contains(@class,'insurecode')]//a");

	// Mobile（有異動權限保單：每一個 mobileKey 為一張卡片）
	private By withMobileKeyRows = By.xpath("//div[contains(@class,'tb_Table_mobile')]//div[contains(@class,'mobileKey')]");
	private By withFirstMobileSelect = By.xpath(
			"(//div[contains(@class,'tb_Table_mobile')]//div[contains(@class,'mobileKey')]//input[@type='checkbox' and @name='list_mobile'])[1]");

	// ====== 無異動權限保單 (Without-Change) 區塊 ======
	private By withoutTblPcLocator = By.xpath(
			"//div[@class='subTitle' and text()='無異動權限保單']/following-sibling::div[contains(@class,'tb_Table_pc')][1]");
	private By withoutTblPcHeaderCells = By.xpath(
			"//div[@class='subTitle' and text()='無異動權限保單']/following-sibling::div[contains(@class,'tb_Table_pc')][1]//div[contains(@class,'headeRow')]//div[contains(@class,'tb_column')]");
	private By withoutTblPcRows = By.xpath(
			"//div[@class='subTitle' and text()='無異動權限保單']/following-sibling::div[contains(@class,'tb_Table_pc')][1]//div[contains(@class,'tb_row') and not(contains(@class,'headeRow'))]");
	private By withoutPcNoDataText = By.xpath(
			"//div[@class='subTitle' and text()='無異動權限保單']/following-sibling::div[contains(@class,'tb_Table_pc')][1]//div[contains(@class,'tb_row') and contains(normalize-space(.),'目前無相關資料')]");
	private By withoutTblPcSelectCbs = By.xpath(
			"//div[@class='subTitle' and text()='無異動權限保單']/following-sibling::div[contains(@class,'tb_Table_pc')][1]//input[@type='checkbox' and @name='list_pc']");

	// 若無異動權限保單有手機版資料（不一定出現，保險起見也支援）
	private By withoutFirstMobileSelect = By.xpath(
			"(//div[@class='subTitle' and text()='無異動權限保單']/following::div[contains(@class,'tb_Table_mobile')]//div[contains(@class,'mobileKey')]//input[@type='checkbox' and @name='list_mobile'])[1]");

	// ====== 其他元件 ======
	private By applyBtnLocator = By.id("button_apply");
	private By cancelBtnLocator = By.id("button_cancel");
	private By selectedDataInputLocator = By.id("selectedData");
	private By changeablePoliciesHiddenLocator = By.id("changeablePolicies");

	// ====== 給下一頁比對用：記錄被選取列 ======
	private static final List<Map<String, String>> selectedRows = new ArrayList<>();
	public static List<Map<String, String>> getSelectedRows() { return selectedRows; }

	public CSRPaymentChannel() {
		// 仍沿用你原本的 pageDisplayCorrectlyLocator（位於：無異動權限保單 / PC 區塊之上方流程區）
		super.pageDisplayCorrectlyLocator = By.xpath(
				"//div[@class='tb_Table_pc' and preceding-sibling::div[@class='cc-flowDiv' and @id='senOTPzone'] and preceding-sibling::div[@class='subTitle' and text()='無異動權限保單']]");
	}

	@Override
	public boolean isPageDisplayCorrectly(int waitingTime) {

		// --- 關閉可能出現的彈窗 ---
		if (findElement(eServiceBtnLocator, false, 10000) != null) {
			click(eServiceBtnLocator, 10000);
			click(confirmBtnLocator, 10000);
		}
		CommUtil.sleep(2);
		if (findElement(paymentChannelConfirmBtnLocator, false, 8000) != null) {
			click(paymentChannelConfirmBtnLocator, 8000);
		}

		// --- 基本顯示檢查 ---
		boolean pageTitleOk = (findElement(paymentMethodPageTitleLocator, false, waitingTime) != null);
		boolean withTitleOk = (findElement(policyWithChangeAuthorityTblTitleLocator, false, waitingTime) != null);
		boolean withoutTitleOk = (findElement(policyWithoutChangeAuthorityTblTitleLocator, false, waitingTime) != null);
		boolean baseOk = super.isPageDisplayCorrectly(waitingTime); // 仍保留你原本的底層檢查

		// --- 驗 headers（有異動權限保單 / PC）---
		boolean withHeaderOk = checkHeaderEquals(withTblPcHeaderCells,
				Arrays.asList("", "保單號碼", "契約始期", "要保人", "被保險人", "險種名稱", "保單狀況", "收費管道", "銀行名稱", "信用卡號/銀行帳號", "自行繳費"));

		// --- 驗 headers（無異動權限保單 / PC）---
		boolean withoutHeaderOk = checkHeaderEquals(withoutTblPcHeaderCells,
				Arrays.asList("", "保單號碼", "契約始期", "要保人", "被保險人", "險種名稱", "保單狀況", "收費管道", "銀行名稱", "信用卡號/銀行帳號"));

		// --- 判斷各區塊是否有資料 ---
		int withPcRows = driver.findElements(withTblPcRows).size();
		int withMobileCards = driver.findElements(withMobileKeyRows).size();
		boolean withHasData = (withPcRows > 0) || (withMobileCards > 0);

		boolean withoutPcNoData = (findElement(withoutPcNoDataText, false, 1500) != null);
		int withoutPcRows = withoutPcNoData ? 0 : driver.findElements(withoutTblPcRows).size();

		// NOTE: 官方 DOM 裡「無異動權限保單 / mobile」若有資料，應該也會產出 mobileKey；因樣本為「無資料」，這裡先採保守策略
		boolean withoutHasData = (withoutPcRows > 0)
				|| (findElement(withoutFirstMobileSelect, false, 500) != null);

		// --- 清空上一次的選取紀錄 ---
		selectedRows.clear();

		// --- 有資料就勾選至少一筆 + 記錄資料 ---
		boolean selectedAny = false;

		// 1) 有異動權限保單
		if (withHasData) {
			// 先嘗試 PC table
			WebElement firstPcCb = findElement(withTblPcSelectCbs, false, 1500);
			if (firstPcCb != null) {
				try {
					WebElement row = getAncestorRow(firstPcCb);
					Map<String, String> rowData = extractPcRowData(row);
					firstPcCb.click();
					selectedRows.add(rowData);
					selectedAny = true;
				} catch (Exception e) {
					logger.warn("[withHasData-PC 勾選失敗] " + e.getMessage());
				}
			} else {
				// 退到 Mobile
				WebElement mobileCb = findElement(withFirstMobileSelect, false, 1500);
				if (mobileCb != null) {
					try {
						WebElement mobileKey = getAncestorByClass(mobileCb, "tb_row mobileKey");
						Map<String, String> rowData = extractMobileRowData(mobileKey);
						mobileCb.click();
						selectedRows.add(rowData);
						selectedAny = true;
					} catch (Exception e) {
						logger.warn("[withHasData-Mobile 勾選失敗] " + e.getMessage());
					}
				}
			}
		}

		// 2) 無異動權限保單
		if (withoutHasData) {
			// 先 PC
			WebElement firstPcCb = findElement(withoutTblPcSelectCbs, false, 1500);
			if (firstPcCb != null) {
				try {
					WebElement row = getAncestorRow(firstPcCb);
					Map<String, String> rowData = extractPcRowData(row);
					firstPcCb.click();
					selectedRows.add(rowData);
					selectedAny = true;
				} catch (Exception e) {
					logger.warn("[withoutHasData-PC 勾選失敗] " + e.getMessage());
				}
			} else {
				// 再 Mobile（若有）
				WebElement mobileCb = findElement(withoutFirstMobileSelect, false, 1500);
				if (mobileCb != null) {
					try {
						WebElement mobileKey = getAncestorByClass(mobileCb, "tb_row mobileKey");
						Map<String, String> rowData = extractMobileRowData(mobileKey);
						mobileCb.click();
						selectedRows.add(rowData);
						selectedAny = true;
					} catch (Exception e) {
						logger.warn("[withoutHasData-Mobile 勾選失敗] " + e.getMessage());
					}
				}
			}
		}

		// --- 只要任一區塊有資料就按「申請」 ---
		if (selectedAny) {
			WebElement applyBtn = findElement(applyBtnLocator, false, waitingTime);
			if (applyBtn != null) {
				click(applyBtnLocator, waitingTime);
			} else {
				logger.warn("[Apply 按鈕不存在] 無法送出");
				return false;
			}
		} else {
			// 兩區都沒有資料：不送出，僅回頂
			click(goUpButton, 15000);
			CommUtil.sleep(2);
		}

		// --- 回傳是否「第一頁任務」成功（頁面基本元素 + header 檢查需通過）---
		boolean mustOk = pageTitleOk && withTitleOk && withoutTitleOk && baseOk && withHeaderOk && withoutHeaderOk;
		if (!mustOk) {
			logger.debug("頁面或表頭驗證未通過");
		}
		return mustOk;
	}

	/* ====================== 私有工具 ====================== */

	private boolean checkHeaderEquals(By headerCellsLocator, List<String> expected) {
		try {
			List<WebElement> cells = driver.findElements(headerCellsLocator);
			List<String> actual = new ArrayList<>();
			for (WebElement c : cells) {
				String t = (c.getText() == null) ? "" : c.getText().replace("\u00A0", " ").trim();
				actual.add(t);
			}
			if (actual.size() != expected.size()) {
				logger.warn("[Header 欄數不符] 預期=" + expected.size() + "，實際=" + actual.size() + "；實際=" + actual);
				return false;
			}
			for (int i = 0; i < expected.size(); i++) {
				if (!expected.get(i).equals(actual.get(i))) {
					logger.warn("[Header 文案不符] index=" + i + ", expected='" + expected.get(i) + "', actual='" + actual.get(i) + "'");
					return false;
				}
			}
			return true;
		} catch (Exception ex) {
			logger.warn("[Header 驗證例外] " + ex.getMessage());
			return false;
		}
	}

	private WebElement getAncestorRow(WebElement anyChildInRow) {
		return anyChildInRow.findElement(By.xpath("./ancestor::div[contains(@class,'tb_row')][1]"));
	}

	private WebElement getAncestorByClass(WebElement el, String mustContain) {
		return el.findElement(By.xpath("./ancestor::div[contains(@class,'" + mustContain + "')][1]"));
	}

	private Map<String, String> extractPcRowData(WebElement row) {
		Map<String, String> m = new HashMap<>();
		m.put("policyNumber", safeText(row, ".//div[contains(@class,'insurecode')]"));
		m.put("commenceDate", safeText(row, ".//div[contains(@class,'date')]"));
		m.put("ownerName",   safeText(row, ".//div[contains(@class,'name')][1]"));
		m.put("insuredName", safeText(row, ".//div[contains(@class,'name')][2]"));
		m.put("productName", safeText(row, ".//div[contains(@class,'flexInsurance')]"));
		m.put("status",      safeText(row, ".//div[contains(@class,'status')]"));
		m.put("paymentMethod", safeText(row, ".//div[contains(@class,'tollmode')]"));
		m.put("bankName",      safeText(row, ".//div[contains(@class,'bankname')]"));
		m.put("accountMasked", safeText(row, ".//div[contains(@class,'creditcard_code')]"));
		m.put("section", "PC");
		return m;
	}

	private Map<String, String> extractMobileRowData(WebElement mobileKeyRow) {
		Map<String, String> m = new HashMap<>();
		String policyNo = safeText(mobileKeyRow, ".//div[contains(@class,'id')]");
		String product = safeText(mobileKeyRow, ".//div[contains(@class,'insurname')]");
		WebElement ext = null;
		try {
			ext = mobileKeyRow.findElement(By.xpath("following-sibling::div[contains(@class,'ext')][1]"));
		} catch (Exception ignore) {}
		m.put("policyNumber", policyNo);
		m.put("productName", product);
		m.put("commenceDate", extVal(ext, "契約始期"));
		m.put("ownerName",    extVal(ext, "要保人"));
		m.put("insuredName",  extVal(ext, "被保險人"));
		m.put("status",       extVal(ext, "保單狀況"));
		m.put("paymentMethod",extVal(ext, "收費管道"));
		m.put("bankName",     extVal(ext, "銀行名稱"));
		m.put("accountMasked",extVal(ext, "信用卡號/銀行帳號"));
		m.put("section", "Mobile");
		return m;
	}

	private String safeText(WebElement scope, String relXpath) {
		try {
			WebElement el = scope.findElement(By.xpath(relXpath));
			String t = el.getText();
			return t == null ? "" : t.trim();
		} catch (Exception e) {
			return "";
		}
	}

	private String extVal(WebElement ext, String label) {
		if (ext == null) return "";
		try {
			WebElement row = ext.findElement(By.xpath(".//div[contains(@class,'tb_row_mobile')][div[contains(@class,'tb_column_mobile')][1][normalize-space(text())='"
					+ label + "']]"));
			return row.findElement(By.xpath("./div[contains(@class,'tb_column_mobile')][2]")).getText().trim();
		} catch (Exception e) {
			return "";
		}
	}
}
