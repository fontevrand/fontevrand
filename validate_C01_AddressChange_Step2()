/* ===== C01 地址變更：戶籍地址下拉 + 地址輸入 + 公司電話 +（不驗證顯示） ===== */
private boolean validate_C01_AddressChange_Step2() {
    waitForStable();

    // ✅ 你要的目標值
    final String TARGET_ZIP_TEXT  = "110 台北市信義區";
    final String TARGET_ZIP_VALUE = "110";
    final String TARGET_ADDRESS   = "永吉路30巷99號";
    final String TARGET_COMPANY_PHONE = "02 37621960";

    // 1) 戶籍地址/郵遞區號 下拉 (id/name → label 鄰近 → 當前 tab 第一個 select)
    By[] zipCandidates = new By[] {
        By.id("clientspc"),
        By.name("clientspc"),
        By.xpath("(//label[contains(normalize-space(),'戶籍') or contains(normalize-space(),'郵遞')]/following::*[self::select])[1]"),
        By.xpath("//div[contains(@class,'tab_content') and contains(@class,'active')]//select[1]")
    };
    WebElement zipSelectEl = findFirstPresent(zipCandidates, 3500);
    if (zipSelectEl == null) {
        logger.error("[C01] 找不到戶籍地址/郵遞區號 下拉");
        return false;
    }
    String zipSelected = selectFromSelectOrBootstrap(getByOf(zipSelectEl), TARGET_ZIP_VALUE, TARGET_ZIP_TEXT);
    if (zipSelected == null) {
        zipSelected = selectByTextFromSelectOrBootstrap(getByOf(zipSelectEl), TARGET_ZIP_TEXT);
    }
    if (zipSelected == null) {
        logger.error("[C01] 郵遞區下拉選擇失敗");
        return false;
    }
    waitForStable(); // 有些頁面選完區域會重新渲染地址欄位

    // 2) 地址輸入框 (id/name → label 鄰近 → 當前 tab 內包含 Address 的第一個 text input)
    By[] addrCandidates = new By[] {
        By.id("clientAddress"),
        By.name("clientAddress"),
        By.id("householdAddress"),
        By.name("householdAddress"),
        By.xpath("(//label[contains(normalize-space(),'地址')][1]/following::*[self::input and @type='text'])[1]"),
        By.xpath("//div[contains(@class,'tab_content') and contains(@class,'active')]//input[@type='text' and (contains(@id,'Address') or contains(@name,'Address'))][1]")
    };
    WebElement addressEl = findFirstPresent(addrCandidates, 3000);
    if (addressEl == null) {
        logger.error("[C01] 找不到地址輸入框");
        return false;
    }
    input(addressEl, TARGET_ADDRESS);
    // 放寬核對（有些頁面會自動轉半形/加路段/去空白）
    String addrVal = addressEl.getAttribute("value");
    if (addrVal == null || normalizeText(addrVal).isEmpty()) {
        logger.error("[C01] 地址輸入未生效");
        return false;
    }

    // 3) 公司電話（支援單欄或 區碼/號碼/分機 三欄）
    if (!setCompanyPhoneRobust("02", "37621960", "")) {
        // 再嘗試單欄（label 鄰近找第一個 text）
        WebElement oneField = findElementIsDisplayed(
            By.xpath("//*[self::label or self::th or self::td or self::div][contains(normalize-space(), '公司') and contains(normalize-space(), '電話')]/following::*[self::input and @type='text'][1]"),
            true, 1200
        );
        if (oneField != null) {
            input(oneField, TARGET_COMPANY_PHONE);
        } else {
            // 找常見單欄 id/name
            WebElement single = findFirstPresent(new By[]{
                By.id("companyPhone"), By.name("companyPhone"),
                By.id("officePhone"),  By.name("officePhone"),
                By.id("companyTel"),   By.name("companyTel")
            }, 800);
            if (single != null) input(single, TARGET_COMPANY_PHONE);
            else logger.warn("[C01] 找不到公司電話欄位（略過不致命）");
        }
    }

    logger.debug("[C01] 戶籍=110 信義、地址=永吉路30巷99號、公司電話=02 37621960 已填寫。");
    return true;
}
