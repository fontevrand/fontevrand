	private boolean switchToHandleIfAlive(String handle) {
		if (handle == null || handle.isBlank()) return false;
		try {
			driver.switchTo().window(handle);
			driver.getTitle();
			driver.switchTo().defaultContent();
			return true;
		} catch (Exception ignore) { return false; }
	}

	private boolean preferMainWindowFocus() {
		if (switchToHandleIfAlive(step1Handle)) return true;
		return switchToMostRecentAliveWindow();
	}

	private boolean isLikelyTransientPopup(String handle) {
		try {
			driver.switchTo().window(handle);
			String url = "";
			try { url = driver.getCurrentUrl(); } catch (Exception ignore) {}
			String title = "";
			try { title = driver.getTitle(); } catch (Exception ignore) {}

			boolean urlLike = false;
			String u = url == null ? "" : url.toLowerCase();
			if (!u.isEmpty()) {
				urlLike = u.startsWith("about:blank")
					 || u.startsWith("edge://") || u.startsWith("chrome://")
					 || u.startsWith("blob:") || u.contains(".pdf")
					 || u.contains("/print") || u.contains("preview")
					 || u.contains("download");
			}

			boolean sizeLike = false;
			try {
				org.openqa.selenium.Dimension sz = driver.manage().window().getSize();
				sizeLike = (sz.getWidth() <= 900 && sz.getHeight() <= 700);
			} catch (Exception ignore) {}

			String t = title == null ? "" : title.toLowerCase();
			return urlLike || sizeLike || t.contains("列印") || t.contains("下載") || t.contains("pdf");
		} catch (Exception e) {
			return true;
		} finally {
			try { driver.switchTo().defaultContent(); } catch (Exception ignore) {}
		}
	}

	private void tapBlankToDismissDownloadBubble() {
		try {
			driver.switchTo().defaultContent();
			WebElement body = findElement(By.tagName("body"), false, 600);
			if (body != null) {
				try { ((JavascriptExecutor)driver).executeScript("arguments[0].scrollIntoView(true);", body); } catch (Exception ignore) {}
				try { new Actions(driver).moveToElement(body, 5, 5).click().perform(); } catch (Exception ignore) {}
			}
			try { new Actions(driver).sendKeys(Keys.ESCAPE).perform(); } catch (Exception ignore) {}
			try { Thread.sleep(100); } catch (InterruptedException ie) { Thread.currentThread().interrupt(); }
		} catch (Exception ignore) {}
	}

