	@Override
	public boolean isPageDisplayCorrectly(int waitingTime) {
		// --- 關閉可能出現的彈窗 ---
		if (findElement(eServiceBtnLocator, false, 10000) != null) {
			click(eServiceBtnLocator, 10000);
			click(confirmBtnLocator, 10000);
		}
		CommUtil.sleep(2);
		if (findElement(paymentChannelConfirmBtnLocator, false, 8000) != null) {
			click(paymentChannelConfirmBtnLocator, 8000);
		}

		// --- 基本顯示檢查 ---
		boolean pageTitleOk = (findElement(paymentMethodPageTitleLocator, false, waitingTime) != null);
		boolean withTitleOk = (findElement(policyWithChangeAuthorityTblTitleLocator, false, waitingTime) != null);
		boolean withoutTitleOk = (findElement(policyWithoutChangeAuthorityTblTitleLocator, false, waitingTime) != null);
		boolean baseOk = super.isPageDisplayCorrectly(waitingTime);

		// --- 判斷是否出現「目前無相關資料」→ 該區整段 skip（含 headers） ---
		boolean withNoData = (findElement(withPcNoDataText, false, 1500) != null);
		boolean withoutNoData = (findElement(withoutPcNoDataText, false, 1500) != null);

		// --- 非 no-data 才做 header 檢查 ---
		boolean withHeaderOk = true;
		boolean withoutHeaderOk = true;
		if (!withNoData) {
			withHeaderOk = checkHeaderEquals(withTblPcHeaderCells,
					Arrays.asList("", "保單號碼", "契約始期", "要保人", "被保險人", "險種名稱", "保單狀況", "收費管道", "銀行名稱", "信用卡號/銀行帳號", "自行繳費"));
		}
		if (!withoutNoData) {
			withoutHeaderOk = checkHeaderEquals(withoutTblPcHeaderCells,
					Arrays.asList("", "保單號碼", "契約始期", "要保人", "被保險人", "險種名稱", "保單狀況", "收費管道", "銀行名稱", "信用卡號/銀行帳號"));
		}

		// --- 清空上一次的選取紀錄 ---
		selectedRows.clear();

		// ========== 第一頁選取邏輯（符合你最新規格） ==========
		boolean selectedOne = false;

		// (A) 先處理【有異動權限保單】，非 no-data 才嘗試
		if (!withNoData) {
			selectedOne = tryPickFirstInSection(
					"有異動權限保單",
					withTblPcSelectCbs,
					withFirstMobileSelect,
					true /* 試 PC 優先 */
			);
		}

		// (B) 若 A 沒選到、且【無異動權限保單】非 no-data，再嘗試
		if (!selectedOne && !withoutNoData) {
			selectedOne = tryPickFirstInSection(
					"無異動權限保單",
					withoutTblPcSelectCbs,
					withoutFirstMobileSelect,
					true
			);
		}

		// === 決策：是否按「申請」 ===
		// 兩區都 no-data → 不送，僅驗證基本顯示即可
		if (withNoData && withoutNoData) {
			logger.info("兩區塊皆為『目前無相關資料』 → 不執行申請，結束第一頁驗證");
			// 回頂（保持你原本的小互動）
			if (findElement(goUpButton, true, 2000) != null) {
				click(goUpButton, 2000);
				CommUtil.sleep(1);
			}
			boolean mustOk = pageTitleOk && withTitleOk && withoutTitleOk && baseOk; // headers 該情況下整段 skip
			if (!mustOk) logger.debug("頁面或流程顯示驗證未完全通過（兩區皆無資料）");
			return mustOk;
		}

		// 至少一區有資料，但還是沒成功勾到 → 直接 fail，避免「看起來沒動作卻 Pass」
		if (!selectedOne) {
			throw new AssertionError("頁面至少一區有資料，但未能成功勾選任何一筆（阻止無動作 Pass）。請查看是否有遮擋或版位漂移。");
		}

		// 有成功勾到 → 進第二頁做比對（不按送出）
		WebElement applyBtn = findElement(applyBtnLocator, false, waitingTime);
		if (applyBtn != null) {
			click(applyBtnLocator, waitingTime);
			boolean confirmOk = new ConfirmPage().isPageDisplayCorrectly(waitingTime);
			boolean mustOk = pageTitleOk && withTitleOk && withoutTitleOk && baseOk && withHeaderOk && withoutHeaderOk && confirmOk;
			if (!mustOk) logger.debug("第一頁或第二頁的表頭/比對未通過");
			return mustOk;
		} else {
			logger.warn("[Apply 按鈕不存在] 無法進入確認頁");
			return false;
		}
	}

	/* ====================== 私有工具 ====================== */

	private boolean checkHeaderEquals(By headerCellsLocator, List<String> expected) {
		try {
			List<WebElement> cells = driver.findElements(headerCellsLocator);
			List<String> actual = new ArrayList<>();
			for (WebElement c : cells) {
				String t = (c.getText() == null) ? "" : c.getText().replace("\u00A0", " ").trim();
				actual.add(t);
			}
			if (actual.size() != expected.size()) {
				logger.warn("[Header 欄數不符] 預期=" + expected.size() + "，實際=" + actual.size() + "；實際=" + actual);
				return false;
			}
			for (int i = 0; i < expected.size(); i++) {
				if (!expected.get(i).equals(actual.get(i))) {
					logger.warn("[Header 文案不符] index=" + i + ", expected='" + expected.get(i) + "', actual='" + actual.get(i) + "'");
					return false;
				}
			}
			return true;
		} catch (Exception ex) {
			logger.warn("[Header 驗證例外] " + ex.getMessage());
			return false;
		}
	}

	/** 嘗試在指定區塊勾選第一筆（先 PC、再 Mobile），成功則記錄 row 資料 */
	private boolean tryPickFirstInSection(String sectionTitle, By pcCheckboxes, By mobileFirstCheckbox, boolean pcFirst){
		// 先 PC
		if (pcFirst) {
			List<WebElement> pcs = driver.findElements(pcCheckboxes);
			if (!pcs.isEmpty()) {
				WebElement cb = pcs.get(0);
				if (safeCenterClickAndSelect(cb, "[第一頁] " + sectionTitle + "(PC)第一筆")) {
					WebElement row = getAncestorRow(cb);
					selectedRows.add(extractPcRowData(row));
					return true;
				} else {
					logger.warn("[{}] PC 第一筆勾選仍未成功（isSelected=false）", sectionTitle);
				}
			}
		}
		// 再 Mobile
		WebElement mcb = findElement(mobileFirstCheckbox, false, 1200);
		if (mcb != null) {
			if (safeCenterClickAndSelect(mcb, "[第一頁] " + sectionTitle + "(Mobile)第一筆")) {
				WebElement mobileKey = getAncestorByClass(mcb, "tb_row mobileKey");
				selectedRows.add(extractMobileRowData(mobileKey));
				return true;
			} else {
				logger.warn("[{}] Mobile 第一筆勾選仍未成功（isSelected=false）", sectionTitle);
			}
		}
		return false;
	}

	/** 置中滾動＋正常點擊；攔截則微調捲動＋JS click；最後確認 isSelected() */
	private boolean safeCenterClickAndSelect(WebElement checkbox, String logPrefix){
		try {
			safeCenterClick(checkbox);
			// 正常 click 一次（若被擋，in catch 補救）
			try {
				checkbox.click();
			} catch (ElementClickInterceptedException e) {
				logger.warn("{}：正常 click 被攔截，改用 JS click；原因：{}", logPrefix, e.getMessage());
				((JavascriptExecutor)driver).executeScript("window.scrollBy(0, 120);");
				((JavascriptExecutor)driver).executeScript("arguments[0].click();", checkbox);
			}
			// 最後再驗一次選取狀態，若仍未勾中，補一個 JS click
			if (!checkbox.isSelected()) {
				((JavascriptExecutor)driver).executeScript("arguments[0].click();", checkbox);
			}
			boolean ok = checkbox.isSelected();
			if (ok) logger.info("{} 已勾選", logPrefix);
			return ok;
		} catch (Exception ex) {
			logger.warn("{} 勾選例外: {}", logPrefix, ex.getMessage());
			return false;
		}
	}

	/** 將元素置中到視窗中，降低被固定 header/浮動元件遮擋風險 */
	private void safeCenterClick(WebElement el){
		try {
			((JavascriptExecutor)driver).executeScript("arguments[0].scrollIntoView({block:'center'});", el);
			CommUtil.sleep(1);
		} catch (Exception ignore) {}
	}

	private WebElement getAncestorRow(WebElement anyChildInRow) {
		return anyChildInRow.findElement(By.xpath("./ancestor::div[contains(@class,'tb_row')][1]"));
	}

	private WebElement getAncestorByClass(WebElement el, String mustContain) {
		return el.findElement(By.xpath("./ancestor::div[contains(@class,'" + mustContain + "')][1]"));
	}

	private Map<String, String> extractPcRowData(WebElement row) {
		Map<String, String> m = new HashMap<>();
		m.put("policyNumber", safeText(row, ".//div[contains(@class,'insurecode')]"));
		m.put("commenceDate", safeText(row, ".//div[contains(@class,'date')]"));
		m.put("ownerName",   safeText(row, ".//div[contains(@class,'name')][1]"));
		m.put("insuredName", safeText(row, ".//div[contains(@class,'name')][2]"));
		m.put("productName", safeText(row, ".//div[contains(@class,'flexInsurance')]"));
		m.put("status",      safeText(row, ".//div[contains(@class,'status')]"));
		m.put("paymentMethod", safeText(row, ".//div[contains(@class,'tollmode')]"));
		m.put("bankName",      safeText(row, ".//div[contains(@class,'bankname')]"));
		m.put("accountMasked", safeText(row, ".//div[contains(@class,'creditcard_code')]"));
		m.put("section", "PC");
		return m;
	}

	private Map<String, String> extractMobileRowData(WebElement mobileKeyRow) {
		Map<String, String> m = new HashMap<>();
		String policyNo = safeText(mobileKeyRow, ".//div[contains(@class,'id')]");
		String product = safeText(mobileKeyRow, ".//div[contains(@class,'insurname')]");
		WebElement ext = null;
		try {
			ext = mobileKeyRow.findElement(By.xpath("following-sibling::div[contains(@class,'ext')][1]"));
		} catch (Exception ignore) {}
		m.put("policyNumber", policyNo);
		m.put("productName", product);
		m.put("commenceDate", extVal(ext, "契約始期"));
		m.put("ownerName",    extVal(ext, "要保人"));
		m.put("insuredName",  extVal(ext, "被保險人"));
		m.put("status",       extVal(ext, "保單狀況"));
		m.put("paymentMethod",extVal(ext, "收費管道"));
		m.put("bankName",     extVal(ext, "銀行名稱"));
		m.put("accountMasked",extVal(ext, "信用卡號/銀行帳號"));
		m.put("section", "Mobile");
		return m;
	}

	private String safeText(WebElement scope, String relXpath) {
		try {
			WebElement el = scope.findElement(By.xpath(relXpath));
			String t = el.getText();
			return t == null ? "" : t.trim();
		} catch (Exception e) {
			return "";
		}
	}

	private String extVal(WebElement ext, String label) {
		if (ext == null) return "";
		try {
			WebElement row = ext.findElement(By.xpath(".//div[contains(@class,'tb_row_mobile')][div[contains(@class,'tb_column_mobile')][1][normalize-space(text())='"
					+ label + "']]"));
			return row.findElement(By.xpath("./div[contains(@class,'tb_column_mobile')][2]")).getText().trim();
		} catch (Exception e) {
			return "";
		}
	}

	/* ===========================================================
	 * ===============  第二頁：確認頁面（不按送出）  =================
	 * =========================================================== */
	public static class ConfirmPage extends AbstractBasePage {

		private By confirmTitle = By.xpath("//div[@id='red_tag' and contains(normalize-space(.),'收費管道(限變更為自行繳費) - 確認')]");
		// PC Table
		private By pcHeaderCells = By.xpath("//div[contains(@class,'tb_Table_pc')]//div[contains(@class,'headeRow')]//div[contains(@class,'tb_column')]");
		private By pcFirstDataRow = By.xpath("(//div[contains(@class,'tb_Table_pc')]//div[contains(@class,'tb_row') and not(contains(@class,'headeRow'))])[1]");

		// Mobile（保守推論）
		private By mobileFirstKey = By.xpath("(//div[contains(@class,'tb_Table_mobile')]//div[contains(@class,'mobileKey')])[1]");

		// Hidden fallback
		private By hiddenSelectedContract0 = By.id("selectedData0.contractNum");

		@Override
		public boolean isPageDisplayCorrectly(int waitingTime) {
			// 等到標題出現
			if (findElement(confirmTitle, false, Math.max(5000, waitingTime)) == null) {
				logger.warn("[第二頁] 標題不存在：收費管道(限變更為自行繳費) - 確認");
				return false;
			}

			// 表頭驗證 (PC)
			boolean headerOk = checkHeaderEquals(pcHeaderCells, Arrays.asList(
					"保單號碼", "要保人", "被保險人", "險種名稱", "異動前收費管道", "異動後收費管道"));

			// 取第一筆顯示資料（PC or Mobile）
			Map<String, String> confirmRow = extractPcFirstRow();
			if (confirmRow == null) {
				confirmRow = extractMobileFirstRow();
			}

			// Hidden 兜底：至少抓到 policyNumber
			if (confirmRow == null || empty(confirmRow.get("policyNumber"))) {
				WebElement h0 = findElement(hiddenSelectedContract0, false, 1000);
				if (h0 != null) {
					if (confirmRow == null) confirmRow = new HashMap<>();
					confirmRow.put("policyNumber", h0.getAttribute("value"));
					logger.info("[第二頁] 以 hidden 兜底取得 policyNumber=" + confirmRow.get("policyNumber"));
				}
			}

			if (confirmRow == null) {
				logger.warn("[第二頁] 無法擷取確認頁資料列");
				return false;
			}

			// 取得第一頁所選的那一筆（只存 1 筆）
			if (CSRPaymentChannel.selectedRows.isEmpty()) {
				logger.warn("[第二頁] 第一頁 selectedRows 為空，無從比對");
				return false;
			}
			Map<String, String> selected = CSRPaymentChannel.selectedRows.get(0);

			// 基本欄位比對
			boolean samePolicy = eq(selected.get("policyNumber"), confirmRow.get("policyNumber"));
			boolean sameOwner  = isBlank(selected.get("ownerName")) || eq(selected.get("ownerName"), confirmRow.get("ownerName"));
			boolean sameInsured= isBlank(selected.get("insuredName")) || eq(selected.get("insuredName"), confirmRow.get("insuredName"));
			boolean sameProduct= isBlank(selected.get("productName")) || eq(selected.get("productName"), confirmRow.get("productName"));

			if (!samePolicy)  logger.warn("[比對] 保單號碼不同 first='" + nz(selected.get("policyNumber")) + "' confirm='" + nz(confirmRow.get("policyNumber")) + "'");
			if (!sameOwner)   logger.warn("[比對] 要保人不同 first='" + nz(selected.get("ownerName")) + "' confirm='" + nz(confirmRow.get("ownerName")) + "'");
			if (!sameInsured) logger.warn("[比對] 被保險人不同 first='" + nz(selected.get("insuredName")) + "' confirm='" + nz(confirmRow.get("insuredName")) + "'");
			if (!sameProduct) logger.warn("[比對] 險種名稱不同 first='" + nz(selected.get("productName")) + "' confirm='" + nz(confirmRow.get("productName")) + "'");

			// 付款方式比對：異動前=第一頁 paymentMethod；異動後=自行繳費
			String expectedBefore = nz(selected.get("paymentMethod"));
			String expectedAfter  = "自行繳費";
			String actualBefore   = nz(confirmRow.get("beforeMethod"));
			String actualAfter    = nz(confirmRow.get("afterMethod"));

			boolean beforeOk = eq(expectedBefore, actualBefore);
			boolean afterOk  = eq(expectedAfter, actualAfter);

			if (!beforeOk) logger.warn("[比對] 異動前收費管道 不符，expected='" + expectedBefore + "', actual='" + actualBefore + "'");
			if (!afterOk)  logger.warn("[比對] 異動後收費管道 不符，expected='自行繳費', actual='" + actualAfter + "'");

			// 這頁不按「確認送出」，僅驗證
			boolean allOk = headerOk && samePolicy && beforeOk && afterOk && sameOwner && sameInsured && sameProduct;
			if (!allOk) {
				logger.debug("[第二頁] 確認頁比對未通過");
			} else {
				logger.info("[第二頁] 確認頁比對通過（不送出）");
			}
			return allOk;
		}

		/* ------------------ 第二頁：擷取工具 ------------------ */

		private Map<String, String> extractPcFirstRow() {
			try {
				WebElement row = findElement(pcFirstDataRow, false, 4000);
				if (row == null) return null;

				Map<String, String> m = new HashMap<>();
				m.put("policyNumber", safeText(row, ".//div[contains(@class,'insurecode')]"));
				// 注意：確認頁的兩個 name 欄位 class 都是 name；以下以順序判斷
				List<WebElement> names = row.findElements(By.xpath(".//div[contains(@class,'name')]"));
				if (names.size() >= 1) m.put("ownerName", trim(names.get(0).getText()));
				if (names.size() >= 2) m.put("insuredName", trim(names.get(1).getText()));
				m.put("productName", safeText(row, ".//div[contains(@class,'flexInsuranceForSure')]"));
				// 兩個 expiry_date：第一個=異動前、第二個=異動後
				List<WebElement> dates = row.findElements(By.xpath(".//div[contains(@class,'expiry_date')]"));
				if (dates.size() >= 1) m.put("beforeMethod", trim(dates.get(0).getText()));
				if (dates.size() >= 2) m.put("afterMethod",  trim(dates.get(1).getText()));
				m.put("section", "PC");
				return m;
			} catch (Exception e) {
				logger.warn("[第二頁-PC 擷取失敗] " + e.getMessage());
				return null;
			}
		}

		private Map<String, String> extractMobileFirstRow() {
			try {
				WebElement key = findElement(mobileFirstKey, false, 1500);
				if (key == null) return null;

				Map<String, String> m = new HashMap<>();
				m.put("policyNumber", safeText(key, ".//div[contains(@class,'id')]"));
				m.put("productName", safeText(key, ".//div[contains(@class,'insurname')]"));

				WebElement ext = null;
				try {
					ext = key.findElement(By.xpath("following-sibling::div[contains(@class,'ext')][1]"));
				} catch (Exception ignore) {}

				m.put("ownerName",    extVal(ext, "要保人"));
				m.put("insuredName",  extVal(ext, "被保險人"));
				m.put("beforeMethod", extVal(ext, "異動前收費管道"));
				m.put("afterMethod",  extVal(ext, "異動後收費管道"));
				m.put("section", "Mobile");
				return m;
			} catch (Exception e) {
				logger.warn("[第二頁-Mobile 擷取失敗] " + e.getMessage());
				return null;
			}
		}

		/* ------------------ 共用小工具（複製一份，避免相依） ------------------ */

		private boolean checkHeaderEquals(By headerCellsLocator, List<String> expected) {
			try {
				List<WebElement> cells = driver.findElements(headerCellsLocator);
				List<String> actual = new ArrayList<>();
				for (WebElement c : cells) {
					String t = (c.getText() == null) ? "" : c.getText().replace("\u00A0", " ").trim();
					actual.add(t);
				}
				if (actual.size() != expected.size()) {
					logger.warn("[第二頁 Header 欄數不符] 預期=" + expected.size() + "，實際=" + actual.size() + "；實際=" + actual);
					return false;
				}
				for (int i = 0; i < expected.size(); i++) {
					if (!expected.get(i).equals(actual.get(i))) {
						logger.warn("[第二頁 Header 文案不符] index=" + i + ", expected='" + expected.get(i) + "', actual='" + actual.get(i) + "'");
						return false;
					}
				}
				return true;
			} catch (Exception ex) {
				logger.warn("[第二頁 Header 驗證例外] " + ex.getMessage());
				return false;
			}
		}

		private String safeText(WebElement scope, String relXpath) {
			try {
				WebElement el = scope.findElement(By.xpath(relXpath));
				String t = el.getText();
				return t == null ? "" : t.trim();
			} catch (Exception e) {
				return "";
			}
		}

		private String extVal(WebElement ext, String label) {
			if (ext == null) return "";
			try {
				WebElement row = ext.findElement(By.xpath(".//div[contains(@class,'tb_row_mobile')][div[contains(@class,'tb_column_mobile')][1][normalize-space(text())='"
						+ label + "']]"));
				return row.findElement(By.xpath("./div[contains(@class,'tb_column_mobile')][2]")).getText().trim();
			} catch (Exception e) {
				return "";
			}
		}

		private String trim(String s) { return s == null ? "" : s.replace("\u00A0", " ").trim(); }
		private boolean eq(String a, String b) { return trim(a).equals(trim(b)); }
		private String nz(String s) { return s == null ? "" : s; }
		private boolean empty(String s) { return s == null || s.trim().isEmpty(); }
		private boolean isBlank(String s) { return s == null || trim(s).isEmpty(); }
	}
