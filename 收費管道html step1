 <script>
/*  20240229 新版menu begin   */  
window.addEventListener("load",function(){	
	if(screen.width>768){
    	menuControl.init();
	}
});

var menuControl = {

    closeAllTab : function(){
        var mainLIs = document.getElementsByClassName("mainLI");
        for(var i=0;i<mainLIs.length;i++){
            mainLIs[i].className = "mainLI";
        }           
        document.getElementById("subMenu_Section").className = "subMenu_Section subMenu-closed";
        this.state.isMenuOpened = false;  
        
        this.destroyMenuMask();
    },

    closeAllSubMenu : function(){
        var subULs = document.getElementsByClassName("subUL-newMenu");
        for(var i=0;i<subULs.length;i++){
            subULs[i].style.display = "none";
        }     
        this.hideDescDialog();
        if(this.config.foldOpenMoreAfterMenuClosed){
            this.foldAllItemLists();
        }
    },

    recoveryAllSubMenu : function(){
        var subULs = document.getElementsByClassName("subUL-newMenu");
        for(var i=0;i<subULs.length;i++){
            subULs[i].style.display = "";
        }
    },

    openSpecifySubMenu : function(idx){     
        var subULs = document.getElementsByClassName("subUL-newMenu");
        for(var i=0;i<subULs.length;i++){
            var tmpCatagory = subULs[i].getAttribute("catagory");          
            if(tmpCatagory==idx){
                subULs[i].style.display = "";
            }
        }        
    },

    hideDescDialog : function(){
        document.getElementById("descDialog").className = "dialogHide";
    },

    foldAllItemLists : function(){
        var openMores = document.getElementsByClassName("openMore opened");
        for(var i=(openMores.length-1);i>=0;i--){
            openMores[i].click();
        }
    },

    bindOpenDetail : function(){
        var self =this;
        var openMores = document.getElementsByClassName("openMore");
        for(var i=0;i<openMores.length;i++){
            openMores[i].onclick = function(){
                var moreItems = this.parentNode.getElementsByClassName("moreItem");
                var img = this.querySelector("img");
                if(this.className=="openMore"){
                    this.className = "openMore opened";                
                    img.className = "rotate180";
                    
					//openItems = [];// //hide texts stack
                    for(var j=0;j<moreItems.length;j++){                   
                        moreItems[j].className = "moreItem -show";
                        // //hide texts stack
                        /*
						openItems.push(moreItems[j]);
                        setTimeout(
                        	function(){
                        		
                        		for(var x in openItems){
                        			openItems[x].style.opacity = 1;                   			
                        		}
                        		
                        	},
                        	250
                        )
                        */
                        // 
                    }  
                    self.state.isOpening = true;    
                    setTimeout(
                        function(){
                            self.state.isOpening = false; 
                        },
                        1000
                    );
                }else{
                    this.className = "openMore"; 
                    img.className = "rotate0";
                    for(var j=0;j<moreItems.length;j++){
                        moreItems[j].className = "moreItem -hidden";
						//moreItems[j].style.opacity = 0;////hide texts stack
                    }                      
                }
            }    
        }
    },

    bindOutMenu : function(){
        var self = this;
        var menu_Section = document.getElementsByClassName("menu_Section");
        menu_Section[0].onmouseover = function(){
            isMouseOverMenu2 = true;
        }
        menu_Section[0].onmouseout = function(){
            isMouseOverMenu2 = false;
        }
        var menu =document.getElementById("subMenu_Section");
        menu.onmouseover = function(){
            isMouseOverMenu = true;
        }        
        menu.onmouseout = function(){
            isMouseOverMenu = false;
        }        
        document.body.onclick = function(){
            if(self.state.isMenuOpened){
                if(!isMouseOverMenu && !isMouseOverMenu2){
                    self.closeAllTab();
                }                
            }
        }
    },

    bindDescOnItems : function(){
        var self = this;
        var papa = document.getElementById("subMenu_Section");
        var items = papa.getElementsByTagName("li");
        for(var i=0;i<items.length;i++){
       	
            if(items[i].querySelector("img")==null){
            	if(items[i].querySelector("a")==null){
                	items[i].onclick = function(){
                		
                        if(this.querySelector("img")==null){
                            var url = this.getAttribute("link");                       
                            if(url!==null && url!==""){
    							var target = this.getAttribute("target");	
    							
    							if(!menuControl.state.isModalShow){
	                            	if(target=="_blank"){
	                            		window.open(url);
	                            	}else{
	                            		window.location.href = url;	
	                            	}
    							}else{
    								menuControl.state.isModalShow = false;
    							}
                            	
                            }else{                   	
                            	return false
                            }                        
                        }                  
                    } 
            		
            	}
              
                items[i].onmouseover = function(){
                    var link = this.getAttribute("link");
                    if(link==null){
                        this.style.cursor = "default";
                        
                    };

                    //if Detail is opening, lag the mouseoverevent for 0.7sec
                    var LI = this;
                    
                    
                    
                    
                    if(self.state.isOpening){
                        setTimeout(
                            function(){
                                loadTextShow();      
                            },700
                        )
                    }else{
                        loadTextShow();               
                    };

                    function loadTextShow(){
                    	
                        //let text = itemDescription[LI.innerHTML];
                	
                        //searchMoreIndeep 
	                    var link = LI.getAttribute("link");
	                    if(link==null){
	                    	var a = LI.querySelector("a");
	                    	if(a!==null){
	                    		//a.style.color = "#e5001f";
	                    		var text = itemDescription[a.innerHTML];
	                    	}
	                    }else{                    	
	                    	var text = itemDescription[LI.innerHTML];
	                    }
                        
                        if(text=="" || text==null){
                            return false
                        }

                        var desc = document.getElementById("descDialog");
                        desc.className = "dialogShow";
                        desc.style.zIndex = 100;                                  

                        if(self.config.descriptInRight){
                            desc.style.top = (LI.offsetTop + 5) + "px";
                            desc.style.left = (LI.offsetLeft + LI.offsetWidth + 0) + "px";
                        }else{
                            desc.style.top = (LI.offsetTop + LI.offsetHeight + 10) + "px";
                            desc.style.left = (LI.offsetLeft + 5) + "px";
                        }

                        document.getElementById("descDialogContent").innerHTML = text;                            
                    }

                }
/*
                items[i].onmouseout = function(){
                    var desc = document.getElementById("descDialog");
                    desc.className = "dialogHide";
                    desc.style.zIndex = -100;
                    
					var LI = this;	
                   	var a = LI.querySelector("a");
                   	if(a!==null){
                   		a.style.color = "#666";
                   	}
                    
                }  
*/                

                items[i].onmouseout = function(){
                    var desc = document.getElementById("descDialog");
                    desc.className = "dialogHide";
                    desc.style.zIndex = -100;
                }                 
                
                
            }
        }
    },

    bindMainMenu : function(){
        var self = this;
        var mainLIs = document.getElementsByClassName("mainLI");
        for(var i=0;i<mainLIs.length;i++){
            mainLIs[i].onclick = function(){
                menuControl.closeAllTab();
                this.className = "mainLI currentMenu";
                document.getElementById("subMenu_Section").className = "subMenu_Section subMenu-opened";
                var key_catagory = this.getAttribute("catagory");
                var catagory = (key_catagory.split("_"))[1];
                self.recoveryAllSubMenu();
                self.closeAllSubMenu();
                self.openSpecifySubMenu(catagory);  
                self.state.isMenuOpened = true;
                
                self.createMenuMask();
            }
        };
    },
    
    createMenuMask : function(){
    	var mask = document.createElement("div");
    	mask.id="newmenu-mask";
    	mask.style.cssText = "position:absolute;width:calc(100vw - 18px);height:calc(100vh + 300px);top:120px;background:#fff;opacity:0.9";
    	document.body.appendChild(mask);
    },

    destroyMenuMask : function(){
    	if(document.getElementById("newmenu-mask")!==null){
    		document.getElementById("newmenu-mask").parentNode.removeChild(document.getElementById("newmenu-mask"));
    	}
    },    
    
    state : {
        isMenuOpened : false,
        isOpening : false,
        isModalShow : false
    },

    config :{
        descriptInRight : false,
        foldOpenMoreAfterMenuClosed : true
    },

    init : function(){

        isMouseOverMenu = false;
        isMouseOverMenu2 = false;
        this.bindMainMenu();
        this.bindOpenDetail();
        this.bindOutMenu();
        this.bindDescOnItems();
        if(this.config.descriptInRight){
            document.getElementById("descDialogArrow").className = "descDialogArrowRight";
        }else{
            document.getElementById("descDialogArrow").className = "descDialogArrowDown"; 
        }
    }
}

