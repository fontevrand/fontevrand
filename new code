			if (firstFeeRadio != null) {
				click(firstFeeRadio, true);
				logger.debug("Selected the first available Payment Fee Radio.");
			}
		} catch (Exception ignore) {}
		
		// ================== B. 付款方式 (沿用保單借款的邏輯) ==================
		
		// 1. 選擇「使用已提供的帳戶」Radio
		WebElement radio = findElementIsDisplayed(useProvidedRadio, true, 3000);
		if (radio == null) {
			logger.warn("Common section: Cannot find 'Use Provided Account' radio.");
			// 不返回 false，因為可能某些變更不需要此選項
		} else {
			click(radio, true);
		}

		// 2. 選擇帳戶
		if (findElement(providedAccountSelect, false, 500) != null) {
			String val = selectFirstOptionFromSelectOrBootstrap(providedAccountSelect);
			if (val == null) {
				logger.error("Common section: Failed to select provided account.");
			}
			// 更新 selectedProvidedAcctText 供後續驗證使用
