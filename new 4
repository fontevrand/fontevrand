	private WebElement firstSelectIn(WebElement scope) {
		try { return scope.findElement(By.xpath(".//select")); } catch (Exception e) { return null; }
	}
	private WebElement firstInputIn(WebElement scope) {
		try { return scope.findElement(By.xpath(".//input[not(@type='hidden')]")); } catch (Exception e) { return null; }
	}
	private WebElement findNearFollowingInput(WebElement base) {
		if (base == null) return null;
		try { return base.findElement(By.xpath("following::*[self::input or self::textarea][1]")); } catch (Exception e) { return null; }
	}
	private WebElement findInScope(WebElement scope, By by) {
		try { return scope.findElement(by); } catch (Exception e) { return null; }
	}
	private WebElement locateSelectByNearbyText(WebElement scope, String... keywords) {
		for (String k : keywords) {
			try {
				WebElement el = scope.findElement(By.xpath(".//*[self::label or self::th or self::div][contains(normalize-space(.),'" + k + "')]/following::select[1]"));
				if (el != null) return el;
			} catch (Exception ignore) {}
		}
		return null;
	}
	private WebElement firstCheckboxByText(WebElement scope, String text) {
		try {
			WebElement label = scope.findElement(By.xpath(".//label[contains(normalize-space(),'" + text + "')]"));
			String forId = label.getAttribute("for");
			if (forId != null && !forId.isBlank()) {
				WebElement cb = scope.findElement(By.id(forId));
				return cb;
			}
			// or the checkbox inside label
			try {
				return label.findElement(By.xpath(".//input[@type='checkbox']"));
			} catch (Exception ignore) {}
		} catch (Exception ignore) {}
		// fallback: any checkbox
		try { return scope.findElement(By.xpath(".//input[@type='checkbox']")); } catch (Exception e) { return null; }
	}
	private By fromElement(WebElement el) {
		// 製作一個可直接用 getSelectedText/選擇器的 By：若有 id，用 id；否則用相對 xpath
		try {
			String id = el.getAttribute("id");
			if (id != null && !id.isBlank()) return By.id(id);
		} catch (Exception ignore) {}
		// 沒 id 就回傳一個就近 xpath（僅供 getSelectedText/select* 使用）
		// 這裡簡化：直接返回一個能重新找到的 xpath（同 scope 再找第一個 select）
		return By.xpath("//div[contains(@class,'tab_content') and contains(@class,'active')]//select");
	}

	/* =========================
	  下拉操作：選到「與預設不同」的項目
	  ========================= */
	private String selectAnyDifferentOption(By selectBy, List<String> preferredVisibleTexts) {
		WebElement sel = findElementIsDisplayed(selectBy, true, 2000);
		if (sel == null) return null;

		String current = getSelectedText(selectBy);
		List<String> options = getAllOptionVisibleTexts(sel);

		// 先按 preferred 順序挑，只要與 current 不同就選
		if (preferredVisibleTexts != null) {
			for (String pv : preferredVisibleTexts) {
				if (pv == null) continue;
				for (String opt : options) {
					if (normalizeText(opt).equals(normalizeText(pv)) && !equalsIgnoreCaseTrim(opt, current)) {
						String done = selectByTextFromSelectOrBootstrap(selectBy, opt);
						return done != null ? getSelectedText(selectBy) : null;
					}
				}
			}
		}

		// 再挑任何一個與 default 不同且不是空白/請選
		for (String opt : options) {
			if (equalsIgnoreCaseTrim(opt, current)) continue;
			String n = normalizeText(opt);
			if (n.isEmpty() || n.contains("請選")) continue;
			String done = selectByTextFromSelectOrBootstrap(selectBy, opt);
			return done != null ? getSelectedText(selectBy) : null;
		}

		// 最後：若真的只有一個選項，就回 null 讓呼叫端決定
		return null;
	}

	private String ensureSelectNotDefault(By selectBy, List<String> preferredOrder) {
		WebElement sel = findElementIsDisplayed(selectBy, true, 2000);
		if (sel == null) return null;
		String cur = getSelectedText(selectBy);
		if (preferredOrder == null) preferredOrder = new ArrayList<>();

		// 依偏好找出第一個與當前不同的
		for (String pv : preferredOrder) {
			List<String> tryTexts = Arrays.asList(pv, pv.trim());
			for (String t : tryTexts) {
				if (t.isEmpty()) {
					// 空白：找文字為空的選項
					String ok = selectOptionIfExists(selectBy, "");
					if (ok != null && !equalsIgnoreCaseTrim(ok, cur)) return ok;
				} else {
					String ok = selectOptionIfExists(selectBy, t);
					if (ok != null && !equalsIgnoreCaseTrim(ok, cur)) return ok;
				}
			}
		}
		// 找不到就走「任一不同」
		return selectAnyDifferentOption(selectBy, null);
	}

	private String pickFirstExists(By selectBy, List<String> texts) {
		for (String t : texts) {
			String got = selectOptionIfExists(selectBy, t);
			if (got != null) return t;
		}
		return null;
	}

	private String selectOptionIfExists(By selectBy, String visibleText) {
		WebElement sel = findElementIsDisplayed(selectBy, true, 1500);
		if (sel == null) return null;
		List<String> options = getAllOptionVisibleTexts(sel);
		for (String opt : options) {
			if (equalsIgnoreCaseTrim(opt, visibleText)) {
				return selectByTextFromSelectOrBootstrap(selectBy, opt);
			}
		}
		return null;
	}

	private List<String> getAllOptionVisibleTexts(WebElement selectEl) {
		List<String> out = new ArrayList<>();
		try {
			Select s = new Select(selectEl);
			for (WebElement o : s.getOptions()) out.add(safeText(o));
			return out;
		} catch (Exception e) {
			// Bootstrap：到 dropdown 裡抓
			try {
				WebElement toggle = findBootstrapToggle(selectEl);
				if (toggle != null) {
					WebElement menu = toggle.findElement(By.xpath("ancestor::div[contains(@class,'bootstrap-select')]//div[contains(@class,'dropdown-menu')]"));
					List<WebElement> items = menu.findElements(By.xpath(".//span[@class='text']"));
					for (WebElement it : items) out.add(safeText(it));
				}
			} catch (Exception ignore) {}
		}
		return out;
	}

	/* =========================
	  解析紅字 => 代碼集合（Cxx/Axx） - 已增強解析能力
	  ========================= */
	private Set<String> parsePolicyChangeErrorToCodes(String errFullText) {
		Set<String> codes = new LinkedHashSet<>();
		String plain = normalizeText(errFullText);
		if (plain.isEmpty()) return codes;

		List<String> lines = new ArrayList<>();
		for (String s : plain.split("(?:<br>|。|\\n)+")) {
			String t = s.trim();
			if (!t.isEmpty()) lines.add(t);
		}

		Map<String,String> labelTextToCode = getPolicyChangeLabelTextToCodeMap();

		for (String line : lines) {
			String phrase = line;
			phrase = phrase.replaceAll("選取之保單(，)?包含不可辦理", "")
                           .replaceAll("選取之保單不可辦理", "")
                           .replaceAll("包含不可辦理", "")
						  .replaceAll("，", "")
						  .replaceAll(",", "")
						  .replaceAll("。", "")
						  .trim();
            String norm = phrase.replace("／", "/").replace(" ", "");

			if (norm.isEmpty()) continue;

			String fromSyn = ERROR_SYNONYM_TO_CODE.get(norm);
            if (fromSyn == null) fromSyn = ERROR_SYNONYM_TO_CODE.get(phrase);
			if (fromSyn != null) { codes.add(fromSyn); continue; }

			String hit = null;
			for (Map.Entry<String,String> e : labelTextToCode.entrySet()) {
				String labelTx = e.getKey().replace("／", "/").replace(" ", "");
				if (labelTx.contains(norm) || norm.contains(labelTx)) { hit = e.getValue(); break; }
			}
			if (hit != null) codes.add(hit);
		}
		return codes;
	}

	/* =========================
	  取得 Step1 上所有 Cxx/Axx label 文案 → Code 對照
	  ========================= */
	private Map<String,String> getPolicyChangeLabelTextToCodeMap() {
		Map<String,String> map = new HashMap<>();
		try {
			List<WebElement> labels = findElements(By.xpath("//label[string-length(@for)=3 and (starts-with(@for,'C') or starts-with(@for,'A'))]"), 3000);
			for (WebElement lb : labels) {
				String forId = lb.getAttribute("for");
				String text = safeText(lb).replaceAll("^\\d+\\.?", "").trim();
				if (forId != null && forId.matches("[CA]\\d{2}")) {
					map.put(text, forId);
				}
			}
		} catch (Exception ignore) {}
		return map;
	}

