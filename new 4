	}

	/* =========================
	   ★ 新增：safeClick / scroll / waitUntilAnyVisible
	   ========================= */
	private void safeClick(By by) {
		WebElement el = findElementIsDisplayed(by, true, 2500);
		if (el != null) safeClick(el);
	}
	private void safeClick(WebElement el) {
		if (el == null) return;
		try {
			scrollIntoView(el);
			el.click();
		} catch (Exception ex) {
			try { ((JavascriptExecutor)driver).executeScript("arguments[0].click();", el); }
			catch (Exception ignore) {}
		}
	}
	private void scrollIntoView(WebElement el) {
		try { ((JavascriptExecutor)driver).executeScript("arguments[0].scrollIntoView({block:'center', inline:'nearest'});", el); }
		catch (Exception ignore) {}
		try { new Actions(driver).moveToElement(el, 1, 1).perform(); } catch (Exception ignore) {}
	}
	private WebElement waitUntilAnyVisible(long timeoutMs, By... locators) {
		long end = System.currentTimeMillis() + Math.max(1, timeoutMs);
		while (System.currentTimeMillis() < end) {
			for (By by : locators) {
				try {
					WebElement e = findElement(by, false, 150);
					if (e != null && e.isDisplayed()) return e;
				} catch (Exception ignore) {}
			}
			try { Thread.sleep(80); } catch (InterruptedException ie) { Thread.currentThread().interrupt(); }
		}
		return null;
	}
