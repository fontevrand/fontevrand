	private WebElement getActiveTabRoot(String code) {
		Integer idx = POLICY_CODE_TO_TAB_INDEX.get(code);
		if (idx == null) return null;
		// 不強制要求 active，直接找對應 tab_x 的內容容器（顯示即視為當前）
		WebElement root = findElement(By.xpath("//div[contains(@class,'tab_content') and contains(@class,'tab_" + idx + "') and not(contains(@style,'display: none'))]"), false, 1500);
		if (root == null) root = findElement(By.xpath("//div[contains(@class,'tab_content') and contains(@class,'tab_" + idx + "')]"), false, 1200);
