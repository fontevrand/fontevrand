 */
public class CSRCreditCardExpiryDateChange extends AbstractBasePage {

    // 【硬寫的測試資料】
    private static final String TARGET_POLICY_NO = "80424859";     // 目標保單號碼 (第一頁選擇)
    private static final String NEW_EXPIRY_MMYY = "01/30";         // 新的效期 MM/YY (第一頁輸入)
    
