	private boolean ensureTabActiveByCode(String code) {
		try {
			Integer idx = POLICY_CODE_TO_TAB_INDEX.get(code);
			if (idx == null) return false;
			By li = By.xpath("//div[contains(@class,'tab_wrapper')]//ul[@class='tab_list']/li[@rel='tab_" + idx + "']");
			WebElement tabLi = findElementIsDisplayed(li, true, 2500);
			if (tabLi == null) return false;
			safeClick(tabLi);

			WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(8));
			By content = By.xpath("//div[contains(@class,'tab_content') and contains(@class,'tab_" + idx + "')]");
			wait.until(ExpectedConditions.visibilityOfElementLocated(content));
			waitGlobalMasksGone(8);
			return true;
		} catch (Exception e) {
			return false;
		}
	}

	private void waitGlobalMasksGone(int seconds) {
		try {
			WebDriverWait w = new WebDriverWait(driver, Duration.ofSeconds(seconds));
			By mask = By.cssSelector(".loading, .modal-backdrop, .blockUI, .spinner");
			w.until(ExpectedConditions.invisibilityOfElementLocated(mask));
		} catch (Exception ignore) {}
	}

	private void clearAndType(WebElement el, String text) {
		try { el.sendKeys(Keys.chord(Keys.CONTROL, "a"), Keys.DELETE); } catch (Exception ignore) {}
		input(el, text);
	}

	private boolean clickReviewAndVerifyStep3() {
		WebElement reviewBtn = findElementIsDisplayed(reviewButtonId, true, 2000);
		if (reviewBtn == null) reviewBtn = findElementIsDisplayed(reviewButtonXPath, true, 2000);
		if (reviewBtn == null) return false;
