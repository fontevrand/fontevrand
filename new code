package com.autotest.pages.csrpage.csrchangepage;

import org.openqa.selenium.By;
import org.openqa.selenium.WebElement;

import submodule.com.autotest.commonpage.AbstractBasePage;
import submodule.com.autotest.utils.CommUtil;

//收費管道(限變更為自行繳費)
public class CSRPaymentChannel extends AbstractBasePage {

	// e-Service 線上變更的按鈕
	private By eServiceBtnLocator = By.xpath("//div[@class='modal-body']/button[@id='E']");

	// 確定按鈕
	private By confirmBtnLocator = By
			.xpath("//div[@class='modal-footer']/div[@class='btn-area']/button[@id='checkSelected']");

	// 【收費管道(限變更為自行繳費)】確定按鈕
	private By paymentChannelConfirmBtnLocator = By.xpath(
			"(//div[contains(@class, 'modal-content')]//p[@id='messageBoxText' and contains(text(), '提醒您，執行【收費管道變更】作業後，系統需作業時間，若您欲使用【行動繳費】方式，請於次二個工作日再登入使用。')]/following::button[contains(text(), '確定') and contains(@class, 'btn red xs')])[1]");

	// Page title
	private By paymentMethodPageTitleLocator = By
			.xpath("//div[@class='redTag' and @id='red_tag' and contains(text(),'收費管道(限變更為自行繳費)')]");

	// 有異動權限保單 Page Title locator check
	private By policyWithChangeAuthorityTblTitleLocator = By.xpath("//div[@class='subTitle' and text()='有異動權限保單']");

	// 無異動權限保單 Page Title locator check
	private By policyWithoutChangeAuthorityTblTitleLocator = By.xpath("//div[@class='subTitle' and text()='無異動權限保單']");

	// 有異動權限保單 table locator
	private By policyWithChangeAuthorityTblLocator = By.xpath(
			"//div[@class='tb_Table_pc' and following-sibling::div[@class='cc-flowDiv' and @id='senOTPzone'] and preceding-sibling::div[@class='subTitle' and text()='有異動權限保單']]");
	
	// go up button
	private By goUpButton = By.xpath("//div[@class='sidebar']//div[@class='hidden-mobile']//a[@class='gotop js-gotop']");

	public CSRPaymentChannel() {

		// 無異動權限保單 table locator
		super.pageDisplayCorrectlyLocator = By.xpath(
				"//div[@class='tb_Table_pc' and preceding-sibling::div[@class='cc-flowDiv' and @id='senOTPzone'] and preceding-sibling::div[@class='subTitle' and text()='無異動權限保單']]");
	}

	@Override
	public boolean isPageDisplayCorrectly(int waitingTime) {

		// eService按鈕存在
		if (findElement(eServiceBtnLocator, false, 10000) != null) {

			click(eServiceBtnLocator, 10000);
			click(confirmBtnLocator, 10000);

		}

		CommUtil.sleep(3);
		
		// 【收費管道(限變更為自行繳費)重要訊息】確定按鈕
		if (findElement(paymentChannelConfirmBtnLocator, false, 10000) != null) {

			click(paymentChannelConfirmBtnLocator, 10000);

		}

		// // 無異動權限保單 table check
		boolean tblWithoutChangeAuthority = super.isPageDisplayCorrectly(waitingTime);

		// Page Title check
		boolean paymentMethodPageTitle = false;
		WebElement pageTitleResult = findElement(paymentMethodPageTitleLocator, false, waitingTime);
		if (pageTitleResult != null) {
			paymentMethodPageTitle = true;
		}

		// 有異動權限保單 table check
		boolean tblWithChangeAuthority = false;
		WebElement displayResult1 = findElement(policyWithChangeAuthorityTblLocator, false, waitingTime);
		if (displayResult1 != null) {
			tblWithChangeAuthority = true;
		}

		// 有異動權限保單 table title check
		boolean tbltitleWithChangeAuthority = false;
		WebElement tbltitleWithChangeAuthorityResult = findElement(policyWithChangeAuthorityTblTitleLocator, false,
				waitingTime);
		if (tbltitleWithChangeAuthorityResult != null) {
			tbltitleWithChangeAuthority = true;
		}

		// 無異動權限保單 table title check
		boolean tbltitleWithoutChangeAuthority = false;
		WebElement tbltitleWithoutChangeAuthorityResult = findElement(policyWithoutChangeAuthorityTblTitleLocator,
				false, waitingTime);
		if (tbltitleWithoutChangeAuthorityResult != null) {
			tbltitleWithoutChangeAuthority = true;
		}

		if (tblWithChangeAuthority && tblWithoutChangeAuthority && paymentMethodPageTitle && tbltitleWithChangeAuthority
				&& tbltitleWithoutChangeAuthority) {
			// click go up button
			click(goUpButton, 15000); 
			CommUtil.sleep(10);
			return true;
		} else {
			logger.debug("頁面未正常顯示，等待時間:" + waitingTime);
			return false;
		}
	}

}
