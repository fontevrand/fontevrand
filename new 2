package com.autotest.pages.csrpage.csrchangepage;

import org.openqa.selenium.By;
import org.openqa.selenium.WebElement;

import submodule.com.autotest.commonpage.AbstractBasePage;
import submodule.com.autotest.utils.CommUtil;

// 繳費專區 -> 信用卡卡號/效期變更
public class CSRCreditCardExpiryDateChange extends AbstractBasePage {

	// e-Service 線上變更的按鈕
	private By eServiceBtnLocator = By.xpath("//div[@class='modal-body']/button[@id='E']");

	// 確定按鈕
	private By confirmBtnLocator = By
			.xpath("//div[@class='modal-footer']/div[@class='btn-area']/button[@id='checkSelected']");

	// 信用卡卡號/效期變更頁面的popup window確認鍵
	private By confirmCreditCardExpiryBtnLocator = By.xpath("//a[@id='chChangeBtn' and contains(., '確定')]");

	// 有異動權限保單
	// private By policyWithChangeAuthorityTblLocator = By.xpath("//div[@class='tabletitle' and contains(text(), '有異動權限保單')]/following-sibling::table[@id='tblenable']");
	private By policyWithChangeAuthorityTblLocator = By.xpath("//div[@class='subTitle' and contains(text(), '有異動權限保單')]/following-sibling::div[@class='tb_Table_pc']");
	// 無異動權限保單
	//private By policyWithoutChangeAuthorityTblLocator = By.xpath("//div[@class='tabletitle' and contains(text(), '無異動權限保單')]/following-sibling::table[@class='table table-condensed table-hover  table-bordered']");
	private By policyWithoutChangeAuthorityTblLocator = By.xpath("//div[@class='subTitle' and contains(text(), '無異動權限保單')]/following-sibling::div[@class='tb_Table_pc']");
	
	// go up button
	private By goUpButton = By.xpath("//div[@class='sidebar']//div[@class='hidden-mobile']//a[@class='gotop js-gotop']");

	public CSRCreditCardExpiryDateChange() {
		

		// 信用卡卡號/效期變更頁面的page title locator
		// super.pageDisplayCorrectlyLocator = By.xpath("//div[@class='span12']//div[@class='tabletitle' and contains(text(), '有異動權限保單')]/preceding-sibling::div[@class='functionname' and contains(text(), '信用卡效期變更')]");
		super.pageDisplayCorrectlyLocator = By.xpath("//div[@class='redTag' and contains(text(),'信用卡卡號/效期變更')]");
	}

	@Override
	public boolean isPageDisplayCorrectly(int waitingTime) {

		// eService按鈕存在
		if (findElement(eServiceBtnLocator, false, 10000) != null) {

			click(eServiceBtnLocator, 10000);
			click(confirmBtnLocator, 10000);

		}
		
		CommUtil.sleep(3);

		// 信用卡卡號/效期變更頁面的popup window確認鍵
		if (findElement(confirmCreditCardExpiryBtnLocator, false, 15000) != null) {

			click(confirmCreditCardExpiryBtnLocator, 15000);

		}

		// 信用卡卡號/效期變更頁面的page title locator
		boolean creditCardPageTitle = super.isPageDisplayCorrectly(waitingTime);

		// 有異動權限保單 check
		boolean tblWithChangeAuthority = false;
		WebElement displayResult1 = findElement(policyWithChangeAuthorityTblLocator, false, waitingTime);
		if (displayResult1 != null) {
			tblWithChangeAuthority = true;
		}

		// 無異動權限保單 check
		boolean tblWithoutChangeAuthority = false;
		WebElement displayResult2 = findElement(policyWithoutChangeAuthorityTblLocator, false, waitingTime);
		if (displayResult2 != null) {
			tblWithoutChangeAuthority = true;
		}

		if (tblWithChangeAuthority && tblWithoutChangeAuthority && creditCardPageTitle) {
			// click go up button
			click(goUpButton, 15000); 
			CommUtil.sleep(5);
			return true;
		} else {
			logger.debug("頁面未正常顯示，等待時間:" + waitingTime);
			return false;
		}
	}

}
