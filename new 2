	/* =========================
	  解析紅字 => 代碼集合（Cxx/Axx）
	  ========================= */
	private Set<String> parsePolicyChangeErrorToCodes(String errFullText) {
		Set<String> codes = new LinkedHashSet<>();
		String plain = normalizeText(errFullText);
		if (plain.isEmpty()) return codes;

		List<String> lines = new ArrayList<>();
		for (String s : plain.split("(?:<br>|。|；|;|、|\\n)+")) {
			String t = s.trim();
			if (!t.isEmpty()) lines.add(t);
		}

		Map<String,String> labelTextToCode = getPolicyChangeLabelTextToCodeMap();

		for (String line : lines) {
			String phrase = line;
			phrase = phrase.replaceAll("選取之保單(，)?包含不可辦理", "")
                           .replaceAll("選取之保單不可辦理", "")
                           .replaceAll("包含不可辦理", "")
						   .replaceAll("，", "")
						   .replaceAll(",", "")
						   .replaceAll("。", "")
						   .trim();
			String norm = phrase.replace("／", "/").replace(" ", "");

			if (norm.isEmpty()) continue;

			String fromSyn = ERROR_SYNONYM_TO_CODE.get(norm);
            if (fromSyn == null) fromSyn = ERROR_SYNONYM_TO_CODE.get(phrase);
			if (fromSyn != null) { codes.add(fromSyn); continue; }
            
			String hit = null;
			for (Map.Entry<String,String> e : labelTextToCode.entrySet()) {
				String labelTx = e.getKey().replace("／", "/").replace(" ", "");
				if (labelTx.contains(norm) || norm.contains(labelTx)) {
					hit = e.getValue(); 
                    logger.debug("[PolicyChange] Match found: Code " + hit + " matched phrase: " + phrase);
					break;
				}
			}
			if (hit != null) codes.add(hit);
		}
		return codes;
	}

	private Map<String,String> getPolicyChangeLabelTextToCodeMap() {
		Map<String,String> map = new HashMap<>();
		try {
			List<WebElement> labels = findElements(By.xpath("//label[string-length(@for)=3 and (starts-with(@for,'C') or starts-with(@for,'A'))]"), 3000);
			for (WebElement lb : labels) {
				String forId = lb.getAttribute("for");
				String text = safeText(lb).replaceAll("^\\d+\\.?", "").trim(); 
				if (forId != null && forId.matches("[CA]\\d{2}")) {
					map.put(text, forId);
				}
			}
		} catch (Exception ignore) {}
		return map;
	}

