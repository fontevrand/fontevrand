				return false;
			}
			click(tabLi, true);

			WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));
			By content = By.xpath(
				"//div[contains(@class,'tab_content') and contains(@class,'tab_" + idx + "')]");
			wait.until(ExpectedConditions.attributeContains(li, "class", "active"));
			wait.until(ExpectedConditions.visibilityOfElementLocated(content));
			waitGlobalMasksGone(10);

			return true;
		} catch (Exception e) {
			logger.error("[Tab] ensureTabActiveByCode failed: " + e.getMessage());
			return false;
		}
	}

