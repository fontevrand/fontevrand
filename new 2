	// CHANGE: 更健壯的 Tab 切換（放寬驗證）
	private boolean activateTab(String code) {
		Integer tabIndex = POLICY_CODE_TO_TAB_INDEX.get(code);
		if (tabIndex == null) {
			logger.debug("Code " + code + " has no specific tab index. Skipping activation.");
			return true; 
		}
		
		By[] tabs = new By[] {
			By.xpath("//div[contains(@class,'tab_wrapper')]//ul[@class='tab_list']/li[@rel='tab_" + tabIndex + "']"),
			By.xpath("//div[contains(@class,'tab_wrapper')]//ul[@class='tab_list']/li[@data-tab='tab_" + tabIndex + "']"),
			By.xpath("//div[contains(@class,'tab_wrapper')]//ul[@class='tab_list']/li[contains(@class,'tab') and (contains(@rel,'" + tabIndex + "') or contains(@data-tab,'" + tabIndex + "'))]")
		};

		WebElement tabElement = null;
		for (By by : tabs) {
			tabElement = findElementIsDisplayed(by, true, 3000);
			if (tabElement != null) break;
		}
		if (tabElement == null) {
			logger.warn("Cannot find tab element for code " + code + " (index=" + tabIndex + ")");
			return false;
		}

		if (!String.valueOf(tabElement.getAttribute("class")).contains("active")) {
			logger.info("Activating tab for code: " + code);
			try { click(tabElement, true); } catch (Exception e) { ((JavascriptExecutor) driver).executeScript("arguments[0].click();", tabElement); }
			waitForStable();
		}

		// 主要容器（舊邏輯）
		By contentLocator = By.xpath("//div[contains(@class,'tab_content') and contains(@class,'tab_" + tabIndex + "')]");
		WebElement content = findElement(contentLocator, false, 2000);
		if (content != null && content.isDisplayed()) return true;

		// 放寬：畫面上是否至少有一個「active 的 tab 內容」
		WebElement anyActive = findElement(By.xpath("//div[contains(@class,'tab_content') and contains(@class,'active')]"), false, 800);
		return anyActive != null && anyActive.isDisplayed();
	}

