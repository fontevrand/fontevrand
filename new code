	// 核心修正：使用 JS 強制設定狀態，提高可靠性
	private void setPolicyChangeChecked(String code, boolean checked) {
		// 檢查 code 格式，兼容 Cxx 和 Axx
		if (code == null || code.length() != 3 || !Character.isLetter(code.charAt(0)) || !Character.isDigit(code.charAt(1)) || !Character.isDigit(code.charAt(2))) return;
		
		By inputBy = By.id(code);
		By labelBy = By.xpath("//label[@for='" + code + "']");
		JavascriptExecutor js = (JavascriptExecutor) driver;

		WebElement input = findElement(inputBy, false, 300);
		WebElement label = findElement(labelBy, false, 300);

		if (input == null) {
            // 如果 input 找不到，嘗試用 JS 獲取其 DOM 元素引用
            try {
                input = (WebElement) js.executeScript("return document.getElementById(arguments[0]);", code);
            } catch (Exception jsIgnore) {
                logger.debug("Cannot find input element #" + code + " even via Javascript.");
                return; 
            }
        }
        
        if (input == null) return;

		try {
			// 1. 判斷目前狀態
			boolean now = false;
			try { now = input.isSelected(); } 
            catch (Exception e) { 
                String checkedStatus = input.getAttribute("checked");
                now = checkedStatus != null && checkedStatus.equalsIgnoreCase("true");
            }
            
            // 2. 如果所需狀態與目前狀態不同，則執行操作
			if (checked != now) {
				logger.debug("[Checkbox Click] Target " + code + " to " + checked + ". Current is " + now);
                
                boolean clickSuccess = false;

                // 嘗試點擊 Label (最可靠的方式，因為 Label 是可視元素)
                if (label != null) {
                    try { js.executeScript("arguments[0].scrollIntoView({block:'center'});", label); } catch (Exception ignore) {}
                    try { label.click(); clickSuccess = true; } 
                    catch (Exception e) { 
                        // Fallback: JS click label
                        try { js.executeScript("arguments[0].click();", label); clickSuccess = true; } catch (Exception ignore) {} 
                    }
                } else if (input.isDisplayed()) {
                    // 如果 input 可見 (不太可能，但預防)
                    try { js.executeScript("arguments[0].scrollIntoView({block:'center'});", input); } catch (Exception ignore) {}
                    try { input.click(); clickSuccess = true; } 
                    catch (Exception e) { 
                        // Fallback: JS click input
                        try { js.executeScript("arguments[0].click();", input); clickSuccess = true; } catch (Exception ignore) {} 
                    }
                }
                
                // 點擊後短暫等待，讓網頁框架處理事件（這是關鍵）
                if (clickSuccess) Thread.sleep(250); 
				
				// 3. 再次檢查狀態
                boolean afterClickNow = false;
                try { afterClickNow = input.isSelected(); } 
                catch (Exception e) { 
                    String checkedStatus = input.getAttribute("checked");
                    afterClickNow = checkedStatus != null && checkedStatus.equalsIgnoreCase("true");
                }
				
				// 4. (最終保險) 如果 Click 後狀態仍不對（即 Click 被網頁框架重置了），強制使用 JavaScript
				if (checked != afterClickNow) {
					logger.warn("[Checkbox Force Override] Click failed/reset for " + code + ". Forcing state to " + checked + " via JS.");
					
					// 強制設定 checked 屬性
					js.executeScript("arguments[0].checked = arguments[1];", input, checked);
					
					// 觸發 change/click 事件，希望能讓網頁框架的監聽器同步數據模型
					js.executeScript("arguments[0].dispatchEvent(new Event('change', {bubbles:true}));", input);
                    js.executeScript("arguments[0].dispatchEvent(new Event('click', {bubbles:true}));", input);
					
					Thread.sleep(150);
				}
			}
		} catch (Exception e) {
             logger.warn("Error setting policy change checkbox " + code + ": " + e.getMessage());
		}
	}

	private List<String> getCheckedPolicyChangeCodes() {
