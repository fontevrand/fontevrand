    /**
     * 【依客戶要求修改】
     * 封裝整個 End-to-End 流程：第一頁驗證 -> 操作 -> 點擊申請 -> 確認頁驗證。
     */
    @Override
    public boolean isPageDisplayCorrectly(int waitingTime) {
        
        // ----------------------------------------------------
        // Part 1: 處理第一頁載入與操作
        // ----------------------------------------------------
        
        // --- 處理可能的 Modal ---
        if (findElement(eServiceBtnLocator, false, 10000) != null) {
            clickWithJSFallback(eServiceBtnLocator, 10000);
            clickWithJSFallback(confirmBtnLocator, 10000);
        }
        CommUtil.sleep(3);

        if (findElement(confirmCreditCardExpiryBtnLocator, false, 15000) != null) {
            clickWithJSFallback(confirmCreditCardExpiryBtnLocator, 15000);
        }

        // --- 頁面標題/區塊容器檢查 ---
        boolean creditCardPageTitle = super.isPageDisplayCorrectly(waitingTime);
        boolean tblWithChangeAuthority = findElement(policyWithChangeAuthorityTblLocator, false, waitingTime) != null;
        boolean tblWithoutChangeAuthority = findElement(policyWithoutChangeAuthorityTblLocator, false, waitingTime) != null;

        if (tblWithChangeAuthority && tblWithoutChangeAuthority && creditCardPageTitle) {
            clickWithJSFallback(goUpButton, 15000);
            CommUtil.sleep(5);
            
            logger.info("第一頁載入驗證通過，開始執行操作流程...");
            
            // 執行第一頁操作 (選擇保單, 輸入資料, 點擊申請)
            if (!executeAndValidateFirstPageActions(waitingTime)) {
                logger.error("第一頁操作失敗，流程終止。");
                return false;
            }
            
            // ----------------------------------------------------
            // Part 2: 處理第二頁（確認頁）驗證
            // ----------------------------------------------------
            logger.info("已成功進入確認頁，開始執行確認頁數據驗證...");
            
            // 實例化確認頁，並執行數據驗證
            ConfirmPage confirmPage = new ConfirmPage();
            
            // 驗證標題
            if (!confirmPage.isPageDisplayCorrectly(waitingTime)) {
                logger.error("【確認頁】Title 未正確顯示，驗證失敗。");
                return false;
            }
            
            // 驗證數據摘要
            if (!confirmPage.verifySummary(
                TARGET_POLICY_NO,
                EXPECTED_POLICY_HOLDER,
                EXPECTED_INSURED,
                EXPECTED_INSURANCE_NAME,
                NEW_EXPIRY_MMYY,
                waitingTime
            )) {
                logger.error("【確認頁】數據驗證失敗，流程終止。");
                return false;
            }
            
            logger.info("整個 End-to-End 流程（第一頁操作與第二頁驗證）成功通過。");
            return true;
            
        } else {
            logger.error("第一頁未正常顯示，流程終止。等待時間:" + waitingTime);
            return false;
        }
    }

    /**
     * 第一頁流程（含表頭驗證、選擇保單、輸入資料、點擊申請）
     */
    private boolean executeAndValidateFirstPageActions(int waitingTime) {
        // --- 有異動權限保單 ---
        WebElement withAuthBlock = findElement(policyWithChangeAuthorityTblLocator, false, waitingTime);
        if (withAuthBlock == null) {
            logger.error("【有異動權限保單】區塊容器不存在。");
            return false;
        }

        if (hasNoData(withAuthBlock)) {
            logger.info("【有異動權限保單】顯示『目前無相關資料』，跳過此區塊驗證。");
        } else {
            // 1. 表頭驗證（PC）
            if (!verifyPcTableHeader(withAuthBlock, WITH_AUTH_PC_HEADERS, "有異動權限保單")) {
                return false;
            }

            // 2. 選指定保單
            if (exists(policyRadioByValue(TARGET_POLICY_NO), waitingTime)) {
                if (!clickWithJSFallback(policyRadioByValue(TARGET_POLICY_NO), waitingTime)) {
                    logger.error("無法點選指定保單的單選框：" + TARGET_POLICY_NO);
                    return false;
                }
                logger.info("已選擇硬寫保單號碼：" + TARGET_POLICY_NO);
            } else {
                By firstRadioInWithAuth = By.xpath(
                    "//div[@class='subTitle' and contains(text(),'有異動權限保單')]" +
                    "/following-sibling::div[@class='tb_Table_pc']" +
                    "//div[contains(@class,'tb_row') and contains(@class,'selector')][1]" +
                    "//input[@type='radio']"
                );
                if (exists(firstRadioInWithAuth, waitingTime)) {
                    WebElement radio = findElement(firstRadioInWithAuth, false, waitingTime);
                    String val = radio.getAttribute("value");
                    if (!clickWithJSFallback(firstRadioInWithAuth, waitingTime)) {
                        logger.error("找不到指定保單，且無法點選第一筆單選框：" + val);
                        return false;
                    }
                    logger.warn("找不到指定保單 " + TARGET_POLICY_NO + "，改選第一筆：" + val);
                } else {
                    logger.error("【有異動權限保單】找不到任何可點選的單選框。");
                    return false;
                }
            }

            // 3. 勾選「效期變更」
            if (!clickWithJSFallback(changeTypeExpiryRadio, waitingTime)) {
                logger.error("無法點選『效期變更』單選框。");
                return false;
            }
            logger.info("已勾選『效期變更』單選框。");

            // 4. 輸入新效期 MM/YY
            WebElement expInput = findElement(ccNewExpiryInput, false, waitingTime);
            if (expInput == null) {
                logger.error("找不到新效期輸入框 #cc-expday。");
                return false;
            }
            try { expInput.clear(); } catch (Exception ignore) {}
            expInput.sendKeys(NEW_EXPIRY_MMYY);
            logger.info("已輸入硬寫新效期（MM/YY）：" + NEW_EXPIRY_MMYY);
        }

        // --- 無異動權限保單 (僅驗證) ---
        WebElement withoutAuthBlock = findElement(policyWithoutChangeAuthorityTblLocator, false, waitingTime);
        if (withoutAuthBlock != null) {
            if (hasNoData(withoutAuthBlock)) {
                logger.info("【無異動權限保單】顯示『目前無相關資料』，跳過此區塊驗證。");
            } else {
                // 表頭驗證（PC）
                if (!verifyPcTableHeader(withoutAuthBlock, WITHOUT_AUTH_PC_HEADERS, "無異動權限保單")) {
                    return false;
                }
                logger.info("【無異動權限保單】資料驗證通過。");
            }
        } else {
            logger.warn("找不到【無異動權限保單】區塊容器。");
        }

        // 5. 點「申請」進入確認頁
        if (!clickWithJSFallback(applyButton, waitingTime)) {
            logger.error("無法點擊『申請』按鈕，操作失敗。");
            return false;
        }
        logger.info("已點擊『申請』，流程繼續到【信用卡卡號/效期變更-確認】頁。");
        return true;
    }
    
    
    // 【健壯點擊方法】
    private boolean clickWithJSFallback(By locator, int waitingTime) {
        WebElement el = findElement(locator, false, waitingTime);
        if (el == null) return false;
        
        try {
            click(locator, waitingTime); 
            logger.debug("標準 click 成功: " + locator);
            return true;
        } catch (Exception e) {
            logger.warn("標準 click 失敗，嘗試 JavaScript click: " + locator + " 錯誤: " + e.getMessage());
            
            WebDriver driver = null;
            try {
                // 嘗試從 WebElement 取得其底層的 WebDriver
                driver = ((WrapsDriver) el).getWrappedDriver();
            } catch (Exception ex) {
                logger.error("無法從 WebElement 取得 WebDriver，無法執行 JavaScript fallback。");
                return false;
            }

            if (driver != null) {
                try {
                     JavascriptExecutor js = (JavascriptExecutor) driver;
                     js.executeScript("arguments[0].click()", el);
                     logger.info("JS click 成功: " + locator);
                     return true;
                } catch (Exception ex) {
                    logger.error("JavaScript click 也失敗: " + locator + " 錯誤: " + ex.getMessage());
                    return false;
                }
            } else {
                logger.error("無法執行 JavaScript fallback，WebDriver 實例不可用。");
                return false;
            }
        }
    }

    // ======= 表頭驗證（PC）=======
    private boolean verifyPcTableHeader(WebElement tableBlock, String[] expectedHeaders, String blockLabel) {
         try {
            List<WebElement> cells = tableBlock.findElements(headerCellsInBlock);
            List<String> actual = new ArrayList<>();
            for (WebElement c : cells) {
                String t = c.getText();
                if (t != null) {
                    t = t.trim();
                    if (!t.isEmpty()) actual.add(t);
                }
            }

            if (actual.size() != expectedHeaders.length) {
                logger.error("【" + blockLabel + "】表頭欄位數不符，期望 " + expectedHeaders.length + " 個，實際 " + actual.size() + " 個；實際=" + actual);
                return false;
            }

            boolean pass = true;
            for (int i = 0; i < expectedHeaders.length; i++) {
                String exp = expectedHeaders[i];
                String act = actual.get(i);
                if (!exp.equals(act)) {
                    logger.error("【" + blockLabel + "】表頭第 " + (i+1) + " 欄不符：期望[" + exp + "]，實際[" + act + "]");
                    pass = false;
                }
            }
            if (pass) {
                logger.info("【" + blockLabel + "】表頭驗證通過：" + actual);
            }
            return pass;
        } catch (Exception e) {
            logger.error("【" + blockLabel + "】表頭驗證例外：" + e.getMessage());
            return false;
        }
    }

    // ===== 共用工具 (略) =====
    private boolean hasNoData(WebElement tableBlock) {
         try {
            List<WebElement> noData = tableBlock.findElements(noDataRowInsideAnyTable);
            if (noData != null && !noData.isEmpty()) {
                for (WebElement e : noData) {
                    String txt = e.getText();
                    if (txt != null && txt.trim().contains("目前無相關資料")) {
                        return true;
                    }
                }
            }
            return false;
        } catch (Exception ex) {
            logger.warn("檢查『目前無相關資料』時發生例外：" + ex.getMessage());
            return false;
        }
    }

    private boolean exists(By locator, int waitingTime) {
        return findElement(locator, false, waitingTime) != null;
    }
    

    /**
     * "MM/YY" → "YYYY年MM月"
     * **修正: 避免 PatternSyntaxException，並確保解析邏輯正確**
     */
    public static String toChineseYearMonth(String mmYY) {
        // 修正後的代碼：使用 \d{2}/\d{2} 來匹配 MM/YY 格式 (如 01/30)
        // 避免 PatternSyntaxException
        if (mmYY == null || !mmYY.matches("\\d{2}/\\d{2}")) {
             return mmYY;
        }
        
        String mm = mmYY.substring(0, 2);
        String yy = mmYY.substring(3, 5);
        int y = Integer.parseInt(yy);
        // 假設年份邏輯： <= 79 (2079) 屬於 2000 年代，否則屬於 1900 年代
        int year = (y <= 79) ? 2000 + y : 1900 + y;
        
        // 確保輸出格式是 YYYY年MM月 (例如 2030年01月)
        return String.format("%d年%02d月", year, Integer.parseInt(mm));
    }

