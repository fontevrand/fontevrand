	private boolean activateTab(String code) {
		Integer tabIndex = POLICY_CODE_TO_TAB_INDEX.get(code);
		if (tabIndex == null) {
			logger.debug("[Tab] Code " + code + " has no specific tab index. Skipping activation.");
			return true; 
		}
		
		// 根據 rel 屬性定位 Tab 標籤並點擊 (例如 rel="tab_1")
		By tabLocator = By.xpath("//div[contains(@class,'tab_wrapper')]//ul[@class='tab_list']/li[@rel='tab_" + tabIndex + "']");
		WebElement tabElement = findElementIsDisplayed(tabLocator, true, 3000);
		
		if (tabElement == null) {
			logger.warn("[Tab] Cannot find tab element for code " + code + " (rel=tab_" + tabIndex + ")");
			return false;
		}
		
		// 檢查是否已經是 active 狀態
		if (!tabElement.getAttribute("class").contains("active")) {
			logger.info("[Tab] Activating tab for code: " + code);
			try {
				click(tabElement, true);
				waitForStable();
			} catch (Exception e) {
				// 使用 JS 點擊作為後備
				((JavascriptExecutor) driver).executeScript("arguments[0].click();", tabElement);
				waitForStable();
			}
		}
		
		// 驗證 Tab 內容是否顯示
		By contentLocator = By.xpath("//div[@class='tab_content tab_" + tabIndex + "' and contains(@class,'active')]");
		WebElement content = findElement(contentLocator, false, 2000);
		boolean ok = content != null && content.isDisplayed();
		if (!ok) logger.warn("[Tab] Content not active for code " + code + " (tab_" + tabIndex + ")");
		return ok;
	}

	private boolean dispatchPolicyChangeStep2Validation() {
		// ★ 防呆保底：確保 allowed 不會是空
		if (allowedPolicyChangeCodes == null || allowedPolicyChangeCodes.isEmpty()) {
			if (!selectedCodes.isEmpty()) {
				allowedPolicyChangeCodes = new ArrayList<>(selectedCodes);
				logger.warn("[PolicyChange] allowed 為空，退回 selectedCodes: " + allowedPolicyChangeCodes);
			} else {
				allowedPolicyChangeCodes = Arrays.asList("C01");
				logger.warn("[PolicyChange] allowed/selected 皆空，硬塞 C01 作為保底。");
			}
		}

		boolean allOk = true;
		for (String code : allowedPolicyChangeCodes) {
			// 1. 激活對應的 Tab
			if (!activateTab(code)) {
				logger.error("[Step2] Failed to activate tab for code: " + code);
				allOk = false;
				continue;
			}

			// 2. 每次切換到代碼專屬 tab 後，先處理一次共用區塊（確保 radio/select 都被點）
			handleCommonStep2Sections();

			// 3. 執行特定 Tab 的驗證邏輯
			boolean ok = true;
			switch (code) {
				case "C01":
					ok = validate_C01_AddressChange_Step2();
					break;
                case "C02":
                    ok = validate_C02_BillingChannelChange_Step2(); 
                    break;
				// TODO: 後續逐步擴充其他 Cxx...
				default:
					logger.debug("[PolicyChange] 暫無驗證實作或跳過: " + code + "（略過但不判 fail）");
					ok = true;
			}
			allOk &= ok;
		}
		return allOk;
	}

