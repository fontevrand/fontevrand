    // ===== 既有 locator（原樣保留/微調） =====
    private By eServiceBtnLocator = By.xpath("//div[@class='modal-body']/button[@id='E']");
    private By confirmBtnLocator = By.xpath("//div[@class='modal-footer']/div[@class='btn-area']/button[@id='checkSelected']");
    private By confirmCreditCardExpiryBtnLocator = By.xpath("//a[@id='chChangeBtn' and contains(., '確定')]");

    // PC 區塊容器
    private By policyWithChangeAuthorityTblLocator = By.xpath("//div[@class='subTitle' and contains(text(), '有異動權限保單')]/following-sibling::div[@class='tb_Table_pc']");
    private By policyWithoutChangeAuthorityTblLocator = By.xpath("//div[@class='subTitle' and contains(text(), '無異動權限保單')]/following-sibling::div[@class='tb_Table_pc']");

    // go top
    private By goUpButton = By.xpath("//div[@class='sidebar']//div[@class='hidden-mobile']//a[@class='gotop js-gotop']");

    // ===== 新增：文字偵測 =====
    private By noDataRowInsideAnyTable = By.xpath(".//*[contains(normalize-space(text()),'目前無相關資料')]");
    private By headerCellsInBlock = By.xpath(".//div[contains(@class,'tb_row') and contains(@class,'headeRow')]//div[contains(@class,'tb_column')]");

    // ===== 新增：第一頁操作 =====
    private By policyRadioByValue(String policyNo) {
        return By.xpath("//input[@type='radio' and ( @name='list_pc' or @name='radio_mobile') and @value='" + policyNo + "']");
    }
    private By changeTypeExpiryRadio = By.xpath("//input[@name='change_type' and @value='cardDate']");
    private By ccNewExpiryInput = By.id("cc-expday");
    private By applyButton = By.id("button_apply");

    // ===== 表頭期望值（PC）=====
    private static final String[] WITH_AUTH_PC_HEADERS = {
        "保單號碼","契約始期","要保人","被保險人","險種名稱","發卡銀行","信用卡號","信用卡效期"
    };
    private static final String[] WITHOUT_AUTH_PC_HEADERS = {
        "保單號碼","起保日期","要保人","被保險人","險種名稱","發卡銀行","信用卡號","信用卡效期"
    };

    public CSRCreditCardExpiryDateChange() {
        super.pageDisplayCorrectlyLocator = By.xpath("//div[@class='redTag' and contains(text(),'信用卡卡號/效期變更')]");
    }

    @Override
    public boolean isPageDisplayCorrectly(int waitingTime) {
        if (findElement(eServiceBtnLocator, false, 10000) != null) {
            click(eServiceBtnLocator, 10000);
            click(confirmBtnLocator, 10000);
        }
        CommUtil.sleep(3);

        if (findElement(confirmCreditCardExpiryBtnLocator, false, 15000) != null) {
            click(confirmCreditCardExpiryBtnLocator, 15000);
        }

        boolean creditCardPageTitle = super.isPageDisplayCorrectly(waitingTime);

        boolean tblWithChangeAuthority = findElement(policyWithChangeAuthorityTblLocator, false, waitingTime) != null;
        boolean tblWithoutChangeAuthority = findElement(policyWithoutChangeAuthorityTblLocator, false, waitingTime) != null;

        if (tblWithChangeAuthority && tblWithoutChangeAuthority && creditCardPageTitle) {
            click(goUpButton, 15000);
            CommUtil.sleep(5);
            return true;
        } else {
            logger.debug("頁面未正常顯示，等待時間:" + waitingTime);
            return false;
        }
    }

    /**
     * 第一頁流程（含表頭驗證）：
     * 1) 各區塊若顯示「目前無相關資料」→ 跳過該區塊表頭與列驗證
     * 2) 有異動權限保單有資料：先做表頭驗證 → 選保單 80424859（找不到則選第一筆）
     * 3) 異動後內容→ 勾效期變更 → 輸入 MM/YY（例 01/30）
     * 4) 點「申請」→ 進入確認頁（本方法不會在確認頁點送出）
     */
    public boolean verifyFirstPageAndGoToConfirm(String expectedPolicyNo, String mmYY, int waitingTime) {
        // --- 有異動權限保單 ---
        WebElement withAuthBlock = findElement(policyWithChangeAuthorityTblLocator, false, waitingTime);
        if (withAuthBlock != null) {
            if (hasNoData(withAuthBlock)) {
                logger.info("【有異動權限保單】顯示『目前無相關資料』，跳過此區塊驗證。");
            } else {
                // 表頭驗證（PC）
                if (!verifyPcTableHeader(withAuthBlock, WITH_AUTH_PC_HEADERS, "有異動權限保單")) {
                    return false;
                }

                // 選指定保單
                if (exists(policyRadioByValue(expectedPolicyNo), waitingTime)) {
                    click(policyRadioByValue(expectedPolicyNo), waitingTime);
                    logger.info("已選擇保單號碼：" + expectedPolicyNo);
                } else {
                    By firstRadioInWithAuth = By.xpath(
                        "//div[@class='subTitle' and contains(text(),'有異動權限保單')]" +
                        "/following-sibling::div[@class='tb_Table_pc']" +
                        "//div[contains(@class,'tb_row') and contains(@class,'selector')][1]" +
                        "//input[@type='radio']"
                    );
                    if (exists(firstRadioInWithAuth, waitingTime)) {
                        WebElement radio = findElement(firstRadioInWithAuth, false, waitingTime);
                        String val = radio.getAttribute("value");
                        click(firstRadioInWithAuth, waitingTime);
                        logger.warn("找不到指定保單 " + expectedPolicyNo + "，改選第一筆：" + val);
                    } else {
                        logger.error("【有異動權限保單】找不到可點選的單選框。");
                        return false;
                    }
                }

                // 勾選「效期變更」
                if (!clickWhenVisible(changeTypeExpiryRadio, waitingTime)) {
                    logger.error("無法點選『效期變更』單選框。");
                    return false;
                }

                // 輸入新效期 MM/YY（例 01/30）
                WebElement expInput = findElement(ccNewExpiryInput, false, waitingTime);
                if (expInput == null) {
                    logger.error("找不到新效期輸入框 #cc-expday。");
                    return false;
                }
                try { expInput.clear(); } catch (Exception ignore) {}
                expInput.sendKeys(mmYY);
                logger.info("已輸入新效期（MM/YY）：" + mmYY);
            }
        } else {
            logger.warn("找不到【有異動權限保單】區塊容器。");
        }

        // --- 無異動權限保單 ---
        WebElement withoutAuthBlock = findElement(policyWithoutChangeAuthorityTblLocator, false, waitingTime);
        if (withoutAuthBlock != null) {
            if (hasNoData(withoutAuthBlock)) {
                logger.info("【無異動權限保單】顯示『目前無相關資料』，跳過此區塊驗證。");
            } else {
                // 表頭驗證（PC）
                if (!verifyPcTableHeader(withoutAuthBlock, WITHOUT_AUTH_PC_HEADERS, "無異動權限保單")) {
                    return false;
                }
                logger.info("【無異動權限保單】有資料（僅驗標題/列；本流程不做點選）。");
            }
        } else {
            logger.warn("找不到【無異動權限保單】區塊容器。");
        }

        // --- 點「申請」進入確認頁 ---
        if (!clickWhenVisible(applyButton, waitingTime)) {
            logger.error("無法點擊『申請』按鈕。");
            return false;
        }
        logger.info("已點擊『申請』，前往【信用卡卡號/效期變更-確認】頁。");
        return true;
    }

    // ======= 表頭驗證（PC）=======
    private boolean verifyPcTableHeader(WebElement tableBlock, String[] expectedHeaders, String blockLabel) {
        try {
            List<WebElement> cells = tableBlock.findElements(headerCellsInBlock);
            List<String> actual = new ArrayList<>();
            for (WebElement c : cells) {
                String t = c.getText();
                if (t != null) {
                    t = t.trim();
                    if (!t.isEmpty()) actual.add(t);
                }
            }

            if (actual.size() != expectedHeaders.length) {
                logger.error("【" + blockLabel + "】表頭欄位數不符，期望 " + expectedHeaders.length + " 個，實際 " + actual.size() + " 個；實際=" + actual);
                return false;
            }

            boolean pass = true;
            for (int i = 0; i < expectedHeaders.length; i++) {
                String exp = expectedHeaders[i];
                String act = actual.get(i);
                if (!exp.equals(act)) {
                    logger.error("【" + blockLabel + "】表頭第 " + (i+1) + " 欄不符：期望[" + exp + "]，實際[" + act + "]");
                    pass = false;
                }
            }
            if (pass) {
                logger.info("【" + blockLabel + "】表頭驗證通過：" + actual);
            }
            return pass;
        } catch (Exception e) {
            logger.error("【" + blockLabel + "】表頭驗證例外：" + e.getMessage());
            return false;
        }
    }

    // ===== 共用工具 =====
    private boolean hasNoData(WebElement tableBlock) {
        try {
            List<WebElement> noData = tableBlock.findElements(noDataRowInsideAnyTable);
            if (noData != null && !noData.isEmpty()) {
                for (WebElement e : noData) {
                    String txt = e.getText();
                    if (txt != null && txt.trim().contains("目前無相關資料")) {
                        return true;
                    }
                }
            }
            return false;
        } catch (Exception ex) {
            logger.warn("檢查『目前無相關資料』時發生例外：" + ex.getMessage());
            return false;
        }
    }

    private boolean exists(By locator, int waitingTime) {
        return findElement(locator, false, waitingTime) != null;
    }

    private boolean clickWhenVisible(By locator, int waitingTime) {
        WebElement el = findElement(locator, false, waitingTime);
        if (el == null) return false;
        try {
            click(locator, waitingTime);
            return true;
        } catch (Exception e) {
            try {
                el.click();
                return true;
            } catch (Exception ex) {
                logger.error("clickWhenVisible 失敗：" + ex.getMessage());
                return false;
            }
        }
    }

    /**
     * "MM/YY" → "YYYY年MM月"
     * 例：01/30 → 2030年01月（00~79 → 20xx；80~99 → 19xx，可依需求調整）
     */
    public static String toChineseYearMonth(String mmYY) {
        if (mmYY == null || !mmYY.matches("\\d{2}/\\d{2}")) return mmYY;
        String mm = mmYY.substring(0, 2);
        String yy = mmYY.substring(3, 5);
        int y = Integer.parseInt(yy);
        int year = (y <= 79) ? 2000 + y : 1900 + y;
        return String.format("%04d年%02d月", year, Integer.parseInt(mm));
    }

