    private static final String EXPECTED_INSURED = "神Ｑ雨翅蛾";
    private static final String EXPECTED_INSURANCE_NAME = "保誠人壽倍感安心終身醫療健康保險";

    // ===== 既有 locator（原樣保留/微調） =====
