	  ========================= */
	private void selectAllPolicyChangeCheckboxes(boolean alsoClearFirst) {
		try {
			List<WebElement> labels = findElements(By.xpath("//label[string-length(@for)=3 and (starts-with(@for,'C') or starts-with(@for,'A'))]"), 4000);
			if (labels == null || labels.isEmpty()) return;

			if (alsoClearFirst) {
				for (WebElement lb : labels) {
					String code = lb.getAttribute("for");
					if (code == null) continue; // ← 修正點（原本少了右括號）
					setPolicyChangeChecked(code, false);
				}
			}

			for (WebElement lb : labels) {
				String code = lb.getAttribute("for");
				if (code == null) continue; // ← 修正點（原本少了右括號）
				// Step1 你指定要略過的代碼，不主動勾選
				if (STEP1_SKIP_CODES.contains(code)) { setPolicyChangeChecked(code, false); continue; }
				setPolicyChangeChecked(code, true);
			}

			// 驗證補強
			List<String> checkedCodes = getCheckedPolicyChangeCodes();
			int attempt = 0;
			while (checkedCodes.size() < (labels.size() * 0.6) && attempt < 2) {
				for (WebElement lb : labels) {
					String code = lb.getAttribute("for");
					if (code == null || checkedCodes.contains(code) || STEP1_SKIP_CODES.contains(code)) continue;
					setPolicyChangeChecked(code, true);
				}
				try { Thread.sleep(300); } catch (InterruptedException ie) { Thread.currentThread().interrupt(); }
				checkedCodes = getCheckedPolicyChangeCodes();
				attempt++;
			}

		} catch (Exception e) {
			logger.error("selectAllPolicyChangeCheckboxes error: " + e.getMessage());
		}
	}

	private void deselectPolicyChangeByCode(String code) { setPolicyChangeChecked(code, false); }

	// 使用 JS 強制設定 checkbox 狀態
	private void setPolicyChangeChecked(String code, boolean checked) {
		if (code == null || !code.matches("[CA]\\d{2}")) return;
		By inputBy = By.id(code);
		By labelBy = By.xpath("//label[@for='" + code + "']");
		JavascriptExecutor js = (JavascriptExecutor) driver;
		WebElement input = findElement(inputBy, false, 300);
		WebElement label = findElement(labelBy, false, 300);

		if (input == null) {
            try { input = (WebElement) js.executeScript("return document.getElementById(arguments[0]);", code); }
            catch (Exception ignore) { return; }
        }
		try {
			boolean now = false;
			try { now = input.isSelected(); }
            catch (Exception e) {
                String checkedStatus = input.getAttribute("checked");
                now = "true".equalsIgnoreCase(checkedStatus);
            }
			if (checked != now) {
                if (label != null) {
                    scrollIntoView(label);
                    safeClick(label);
                } else if (input.isDisplayed()) {
					scrollIntoView(input);
                    safeClick(input);
                }
				try { Thread.sleep(150); } catch (InterruptedException ie) { Thread.currentThread().interrupt(); }
                boolean after = false;
                try { after = input.isSelected(); }
                catch (Exception e) {
                    String checkedStatus = input.getAttribute("checked");
                    after = "true".equalsIgnoreCase(checkedStatus);
                }
				if (checked != after) {
					js.executeScript("arguments[0].checked = arguments[1]; arguments[0].dispatchEvent(new Event('change',{bubbles:true}));", input, checked);
				}
			}
		} catch (Exception ignore) {
		} finally {
			try {
				boolean finalState;
				try { finalState = input.isSelected(); }
				catch (Exception ex) {
					String checkedStatus = input.getAttribute("checked");
					finalState = "true".equalsIgnoreCase(checkedStatus);
				}
				if (finalState) selectedCodes.add(code); else selectedCodes.remove(code);
			} catch (Exception ignore) {}
		}
	}

	private List<String> getCheckedPolicyChangeCodes() {
		if (!isInStep1()) return new ArrayList<>(selectedCodes);
