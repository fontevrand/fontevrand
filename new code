	/* =========================
	  解析紅字 => 代碼集合（Cxx/Axx） - 已增強解析能力
	  ========================= */
	private Set<String> parsePolicyChangeErrorToCodes(String errFullText) {
		Set<String> codes = new LinkedHashSet<>();
		String plain = normalizeText(errFullText);
		if (plain.isEmpty()) return codes;

		// 依 <br> 或 。 斷句 
		List<String> lines = new ArrayList<>();
		for (String s : plain.split("(?:<br>|。|\\n)+")) {
			String t = s.trim();
			if (!t.isEmpty()) lines.add(t);
		}

		// 準備 labelText -> code 對照
		Map<String,String> labelTextToCode = getPolicyChangeLabelTextToCodeMap();

		for (String line : lines) {
			String phrase = line;
			
            // 增強切割邏輯：專注於找出不可辦理的項目名稱
            // 刪除常見的開頭語句，留下核心項目名稱
			phrase = phrase.replaceAll("選取之保單(，)?包含不可辦理", "")
                           .replaceAll("選取之保單不可辦理", "")
                           .replaceAll("包含不可辦理", "")
						  .replaceAll("，", "")
						  .replaceAll(",", "")
						  .replaceAll("。", "")
						  .trim();
            
            // 標準化：去全形斜線差異、去空格
            String norm = phrase.replace("／", "/").replace(" ", "");

			if (norm.isEmpty()) continue;

			// 1. 嘗試匹配同義字表 (例如：紅利匯款帳戶變更 -> C54)
			String fromSyn = ERROR_SYNONYM_TO_CODE.get(norm);
            if (fromSyn == null) {
                // 嘗試使用原始 phrase 匹配 (可能包含分隔符差異)
                fromSyn = ERROR_SYNONYM_TO_CODE.get(phrase);
            }
			if (fromSyn != null) { codes.add(fromSyn); continue; }
            
            // 2. 嘗試模糊匹配
			String hit = null;
			for (Map.Entry<String,String> e : labelTextToCode.entrySet()) {
				// Checkbox 的標籤文字（標準化）
				String labelTx = e.getKey().replace("／", "/").replace(" ", "");
				
				// 檢查紅字片段是否包含 Checkbox 標籤文字 (或反之)
				if (labelTx.contains(norm) || norm.contains(labelTx)) {
					hit = e.getValue(); 
                    logger.debug("[PolicyChange] Match found: Code " + hit + " matched phrase: " + phrase);
					break;
				}
			}
			
			if (hit != null) {
				codes.add(hit);
			} else {
				logger.debug("[PolicyChange] 紅字片段無對應 code: " + phrase);
			}
		}
		return codes;
	}

	/* =========================
	  取得 Step1 上所有 Cxx/Axx label 文案 → Code 對照
	  ========================= */
	private Map<String,String> getPolicyChangeLabelTextToCodeMap() {
		Map<String,String> map = new HashMap<>();
		try {
			// 修正 XPath 以包含 Cxx 和 Axx (字串長度為 3)
			List<WebElement> labels = findElements(By.xpath("//label[string-length(@for)=3 and (starts-with(@for,'C') or starts-with(@for,'A'))]"), 3000);
			for (WebElement lb : labels) {
				String forId = lb.getAttribute("for");
				// 由於 HTML 顯示為 "01.地址變更"，我們去除開頭的數字編號和點號
				String text = safeText(lb).replaceAll("^\\d+\\.?", "").trim(); 
				if (forId != null && forId.matches("[CA]\\d{2}")) {
					map.put(text, forId);
				}
			}
		} catch (Exception ignore) {}
		return map;
	}

	/* =========================
	  勾/反勾：保單變更 Cxx/Axx
	  ========================= */
	private void selectAllPolicyChangeCheckboxes(boolean alsoClearFirst) {
		try {
			// 修正 XPath 以包含 Cxx 和 Axx
			List<WebElement> labels = findElements(By.xpath("//label[string-length(@for)=3 and (starts-with(@for,'C') or starts-with(@for,'A'))]"), 4000);
			if (labels == null || labels.isEmpty()) return;
			
			// 步驟 1: 先全部反勾 (如果需要)
			if (alsoClearFirst) {
				for (WebElement lb : labels) {
					String code = lb.getAttribute("for");
					if (code == null) continue;
					try { setPolicyChangeChecked(code, false); } catch (Exception ignore) {}
				}
			}
			
			// 步驟 2: 嘗試勾選所有選項
			for (WebElement lb : labels) {
				String code = lb.getAttribute("for");
				if (code == null) continue;
				setPolicyChangeChecked(code, true);
			}
			
			// 步驟 3: 驗證並強制設定狀態（防止點擊失敗）
			List<String> checkedCodes = getCheckedPolicyChangeCodes();
			int attempt = 0;
			// 如果已勾選的數量小於總數的 80% (寬鬆閾值) 且重試次數少於 2 次
			while (checkedCodes.size() < (labels.size() * 0.8) && attempt < 2) {
				logger.warn("[PolicyChange] Checkbox 檢查發現選取不全，準備重試勾選。已勾選: " + checkedCodes.size() + " / 總數: " + labels.size());
				for (WebElement lb : labels) {
					String code = lb.getAttribute("for");
					// 如果該代碼已經在 checkedCodes 中，則跳過重試
					if (code == null || checkedCodes.contains(code)) continue;
					// 針對未勾選的，強制再調用一次 setPolicyChangeChecked
					setPolicyChangeChecked(code, true); 
				}
				Thread.sleep(500); // 等待網頁反應
				checkedCodes = getCheckedPolicyChangeCodes();
				attempt++;
			}

			logger.debug("[PolicyChange] 最終勾選結果: " + checkedCodes.size() + " / 總數: " + labels.size());

		} catch (Exception e) {
			logger.error("selectAllPolicyChangeCheckboxes error: " + e.getMessage());
		}
	}

