	/* ---------------------------
	   ★ 強化版 Tab 切換（不依賴 active）
	   --------------------------- */
	private boolean activateTab(String code) {
		Integer tabIndex = POLICY_CODE_TO_TAB_INDEX.get(code);
		if (tabIndex == null) {
			logger.debug("[Tab] Code " + code + " has no specific tab index. Skipping activation.");
			return true;
		}
		// 1) 找到 li 或 a，點一次（用 safeClick + scroll）
		By li1 = By.xpath("//div[contains(@class,'tab_wrapper')]//ul[@class='tab_list']//*[self::li or self::a][@rel='tab_" + tabIndex + "']");
		By li2 = By.cssSelector("div.tab_wrapper ul.tab_list [rel='tab_" + tabIndex + "']");
		WebElement tabElement = findElementIsDisplayed(li1, true, 2000);
		if (tabElement == null) tabElement = findElementIsDisplayed(li2, true, 1500);
		if (tabElement == null) {
			logger.warn("[Tab] Cannot find tab element for code " + code + " (rel=tab_" + tabIndex + ")");
			return false;
		}
		safeClick(tabElement);

		// 2) 等「任何一種」內容區塊變為可見（ID / class / style）
		WebElement content = waitUntilAnyVisible(4000,
			By.xpath("//div[contains(@class,'tab_content')][contains(@class,'tab_" + tabIndex + "') and not(contains(@style,'display: none'))]"),
			By.xpath("//*[@id='tab_" + tabIndex + "'][not(contains(@style,'display: none'))]"),
			By.xpath("//div[contains(@class,'tab_content') and contains(@class,'tab_" + tabIndex + "')][.//select or .//input or .//table]"),
			// 保底：標籤上的 active（若有）
			By.xpath("//ul[contains(@class,'tab_list')]//*[self::li or self::a][@rel='tab_" + tabIndex + "'][contains(@class,'active')]")
		);
		if (content != null) {
			scrollIntoView(content);
			waitGlobalMasksGone(6);
			return true;
		}

		// 若第一次沒切成功，再點一次並短暫等待
		safeClick(tabElement);
		content = waitUntilAnyVisible(3000,
			By.xpath("//div[contains(@class,'tab_content')][contains(@class,'tab_" + tabIndex + "') and not(contains(@style,'display: none'))]"),
			By.xpath("//*[@id='tab_" + tabIndex + "'][not(contains(@style,'display: none'))]")
		);
		boolean ok = content != null && content.isDisplayed();
		if (!ok) logger.warn("[Tab] rel=tab_{} appears not visible after click.", tabIndex);
		return ok;
	}

	// 依代碼進入各 Tab 執行填寫／調整
	private boolean dispatchPolicyChangeStep2Validation() {
		// 防呆
		if (allowedPolicyChangeCodes == null || allowedPolicyChangeCodes.isEmpty()) {
			if (!selectedCodes.isEmpty()) {
				allowedPolicyChangeCodes = new ArrayList<>(selectedCodes);
			} else {
				allowedPolicyChangeCodes = Arrays.asList("C01");
			}
		}

		boolean allOk = true;
		for (String code : allowedPolicyChangeCodes) {
			// 跳過你指定的 skip
			if (STEP1_SKIP_CODES.contains(code)) continue;

			if (!activateTab(code)) {
				allOk = false;
				continue;
			}

			// 每次切換到代碼專屬 tab 後，先處理一次共用區塊（確保 radio/select 都被點）
			handleCommonStep2Sections();

			boolean ok = true;
			switch (code) {
				case "C01": ok = validate_C01_AddressChange_Step2(); break;
				case "C03": ok = validate_C03_SignatureChange_Step2(); break;
				case "A04": ok = validate_A04_PayFreqChange_Step2(); break;
				case "A10": ok = validate_A10_BasicInfoChange_Step2(); break;
				case "A11": ok = validate_A11_OccupationLevelChange_Step2(); break;
				case "C35": ok = validate_C35_ReissuePolicy_Step2(); break;
				case "C02": // 依需求不處理
				case "A16": // 依需求不處理
					ok = true; break;
				default:
					ok = true; // 其他代碼暫不處理，也不判失敗
			}
			allOk &= ok;
		}
		return allOk;
	}

