	/* =========================================================
	  NEW ====== 保單變更：全選（穩定） → 依紅字反勾 → 進 Step2
	  ========================================================= */
	private boolean runPolicyChange_AllSelect_FilterAndEnterStep2() {
		// 勾保單
		if (!ensureChecked(By.id("checkbox" + POLICY_NO), By.xpath(policyChangeCheckboxLocator), 6000)) return false;

		// 選「保單變更」
		WebElement pcRadio = findElementIsDisplayed(policyChangeRadio, true, 4000);
		if (pcRadio == null) return false;
		click(pcRadio, true);
		waitForStable();

		// (A) 穩定「全選」：用 JS 設值避免一邊選一邊被反勾
		selectAllPolicyChangeCheckboxesStable();

		// (B) 按下一步
		WebElement next = findElementIsDisplayed(By.xpath(stepOneNextButtonLocator), true, 4000);
		if (next == null) return false;
		click(next, true);
		waitForStable();

		// (C) 若有紅字，解析要 **反勾** 的代碼（可能多輪）
		for (int round = 1; round <= 3; round++) {
			String errText = tryGetText(policyChangeErrMeg);
			if (errText == null || normalizeText(errText).isEmpty()) break;

			Set<String> shouldUncheck = parsePolicyChangeErrorToCodes(errText);
			if (shouldUncheck.isEmpty()) break;

			for (String code : shouldUncheck) {
				setPolicyChangeChecked(code, false); // 去抖動 + JS 強制
			}
			waitForStable();

			// 再按下一步
			click(next, true);
			waitForStable();
		}

		allowedPolicyChangeCodes = getCheckedPolicyChangeCodes();
		return !allowedPolicyChangeCodes.isEmpty();
	}

	/** 用 JS 一次把所有 Cxx/Axx checkbox 設為「勾選」，並同步 label 樣式；避免 click 造成 toggle */
	private void selectAllPolicyChangeCheckboxesStable() {
		try {
			List<WebElement> inputs = findElements(
				By.xpath("//input[@type='checkbox' and string-length(@id)=3 and (starts-with(@id,'C') or starts-with(@id,'A'))]"),
				4000
			);
			if (inputs == null || inputs.isEmpty()) return;

			JavascriptExecutor js = (JavascriptExecutor) driver;

			for (WebElement in : inputs) {
				try {
					if (!in.isDisplayed() || !in.isEnabled()) continue;
					if (in.isSelected()) continue;

					js.executeScript(
						"var el=arguments[0];"
					  + "el.checked=true;"
					  + "el.dispatchEvent(new Event('input',{bubbles:true}));"
					  + "el.dispatchEvent(new Event('change',{bubbles:true}));");
					// 同步 label 樣式
					String id = in.getAttribute("id");
					if (id != null && !id.isEmpty()) {
						try {
							WebElement lb = driver.findElement(By.xpath("//label[@for='" + id + "']"));
							js.executeScript(
								"var lb=arguments[0];"
							  + "lb.classList.add('active');"
							  + "lb.classList.add('checked');"
							  + "lb.setAttribute('aria-checked','true');", lb);
						} catch (Exception ignore) {}
					}
				} catch (Exception ignore) {}
			}

			// 輕量驗證：不夠就補一次
			List<String> checked = getCheckedPolicyChangeCodes();
			if (checked.size() < inputs.size() * 0.8) {
				for (WebElement in : inputs) {
					try {
						if (!in.isDisplayed() || !in.isEnabled()) continue;
						if (in.isSelected()) continue;
						js.executeScript(
							"var el=arguments[0];"
						  + "el.checked=true;"
						  + "el.dispatchEvent(new Event('input',{bubbles:true}));"
						  + "el.dispatchEvent(new Event('change',{bubbles:true}));", in);
					} catch (Exception ignore) {}
				}
			}
			try { Thread.sleep(200); } catch (InterruptedException ie) { Thread.currentThread().interrupt(); }
		} catch (Exception e) {
			logger.warn("selectAllPolicyChangeCheckboxesStable error: " + e.getMessage());
		}
