    public static class ConfirmPage extends AbstractBasePage {

        private By confirmPageTitle = By.xpath("//div[@class='redTag' and contains(.,'信用卡卡號/效期變更 - 確認')]");

        // PC
        private By pcPolicyNo = By.xpath("//div[@class='tb_Table_pc']//div[contains(@class,'tb_row')][not(contains(@class,'headeRow'))]//div[@class='tb_column insurecode']//a");
        private By pcPolicyholder = By.xpath("//div[@class='tb_Table_pc']//div[contains(@class,'tb_row')][not(contains(@class,'headeRow'))]//div[@class='tb_column name'][1]");
        private By pcInsured = By.xpath("//div[@class='tb_Table_pc']//div[contains(@class,'tb_row')][not(contains(@class,'headeRow'))]//div[@class='tb_column name'][2]");
        private By pcInsuranceName = By.xpath("//div[@class='tb_Table_pc']//div[contains(@class,'tb_row')][not(contains(@class,'headeRow'))]//div[contains(@class,'flexInsuranceForSure')]");

        // Mobile（備援）
        private By mPolicyNo = By.xpath("//div[@class='tb_Table_mobile']//div[contains(@class,'mobileKey')]//div[@class='tb_column id']/a");
        private By mInsuranceName = By.xpath("//div[@class='tb_Table_mobile']//div[contains(@class,'mobileKey')]//div[@class='tb_column insurname']");
        private By mPolicyholder = By.xpath("//div[@class='tb_Table_mobile']//div[@class='tb_row ']/div[@class='tb_row_mobile'][div[@class='tb_column_mobile' and normalize-space()='要保人']]/div[last()]");
        private By mInsured = By.xpath("//div[@class='tb_Table_mobile']//div[@class='tb_row ']/div[@class='tb_row_mobile'][div[@class='tb_column_mobile' and normalize-space()='被保險人']]/div[last()]");

        // 比較表 - **修正: 優化 afterExpiry Locator**
        // 嘗試定位到 項目為 '信用卡效期' 的那一行，然後取第三個欄位 (異動後)
        private By afterExpiry = By.xpath("//div[@class='comparing_table']//div[@class='row'][normalize-space(./div[1])='信用卡效期']/div[3]");
        private By beforeExpiry = By.xpath("//div[@class='comparing_table']//div[@class='row'][normalize-space(./div[1])='信用卡效期']/div[2]");

        // Hidden（備援）
        private By hidPolicyNo = By.id("contractNum");
        private By hidPolicyholder = By.id("policyholderName");
        private By hidInsured = By.id("insuredName");
        private By hidInsuranceName = By.id("insuranceName");
        private By hidEndYear = By.id("endYear");
        private By hidEndMonth = By.id("endMonth");
        private By hidChangeType = By.id("changeType");

        public ConfirmPage() {
            super.pageDisplayCorrectlyLocator = confirmPageTitle;
        }

        @Override
        public boolean isPageDisplayCorrectly(int waitingTime) {
            return super.isPageDisplayCorrectly(waitingTime);
        }

        /** 驗證確認頁摘要 + 比對異動後效期（不會按確認送出） */
        public boolean verifySummary(String expectedPolicyNo,
                                     String expectedPolicyholder,
                                     String expectedInsured,
                                     String expectedInsuranceName,
                                     String inputMmYY,
                                     int waitingTime) {

            if (!isPageDisplayCorrectly(waitingTime)) {
                logger.error("【確認頁】title 未正確顯示。");
                return false;
            }

            String vPolicyNo = textOrNull(pcPolicyNo, waitingTime);
            String vPolicyholder = textOrNull(pcPolicyholder, waitingTime);
            String vInsured = textOrNull(pcInsured, waitingTime);
            String vInsuranceName = textOrNull(pcInsuranceName, waitingTime);

            if (vPolicyNo == null) { // PC 抓不到→fallback mobile
                vPolicyNo = textOrNull(mPolicyNo, waitingTime);
                if (vInsuranceName == null) vInsuranceName = textOrNull(mInsuranceName, waitingTime);
                if (vPolicyholder == null) vPolicyholder = textOrNull(mPolicyholder, waitingTime);
                if (vInsured == null) vInsured = textOrNull(mInsured, waitingTime);
            }

            boolean ok = true;
            ok &= assertEquals("保單號碼", expectedPolicyNo, vPolicyNo);
            ok &= assertEquals("要保人", expectedPolicyholder, vPolicyholder);
            ok &= assertEquals("被保險人", expectedInsured, vInsured);
            ok &= assertEquals("險種名稱", expectedInsuranceName, vInsuranceName);

            // 計算期望值 (YYYY年MM月 格式)
            String expectedAfter = CSRCreditCardExpiryDateChange.toChineseYearMonth(inputMmYY);
            
            // 讀取實際值
            String vAfter = textOrNull(afterExpiry, waitingTime);
            
            // 備援邏輯: 如果讀取不到元素，就嘗試用隱藏欄位值來構建（雖然 log 顯示隱藏欄位也沒找到，但保留備援邏輯的結構）
            if (vAfter == null || vAfter.isEmpty() || vAfter.contains("null")) {
                String yy = attrOrNull(hidEndYear, "value");  // e.g. "30"
                String mm = attrOrNull(hidEndMonth, "value"); // e.g. "01"
                if (yy != null && mm != null) {
                     // 這邊的邏輯與 toChineseYearMonth 重複且可能不準確，但保留作為最後 fallback
                     int yearPrefix = (Integer.parseInt(yy) <= 79) ? 2000 : 1900;
                     vAfter = String.format("%d%s年%s月", yearPrefix, yy, mm);
                     logger.warn("使用隱藏欄位值作為日期備援：" + vAfter);
                }
            }
            
            ok &= assertEquals("信用卡效期（異動後）", expectedAfter, vAfter);

            // hidden sanity check（存在才比）
            ok &= equalsIfPresent("hidden 保單號碼", expectedPolicyNo, attrOrNull(hidPolicyNo, "value"));
            ok &= equalsIfPresent("hidden 要保人", expectedPolicyholder, attrOrNull(hidPolicyholder, "value"));
            ok &= equalsIfPresent("hidden 被保險人", expectedInsured, attrOrNull(hidInsured, "value"));
            ok &= equalsIfPresent("hidden 險種名稱", expectedInsuranceName, attrOrNull(hidInsuranceName, "value"));
            ok &= equalsIfPresent("hidden 異動類型", "cardDate", attrOrNull(hidChangeType, "value"));
            // 由於 inputMmYY=01/30，所以要比對 01, 30
            if (inputMmYY.matches("\\d{2}/\\d{2}")) {
                ok &= equalsIfPresent("hidden endYear", inputMmYY.substring(3,5), attrOrNull(hidEndYear, "value"));
                ok &= equalsIfPresent("hidden endMonth", inputMmYY.substring(0,2), attrOrNull(hidEndMonth, "value"));
            }


            return ok;
        }

        // ----- 小工具 -----
        private String textOrNull(By locator, int waitingTime) {
            // 調整 findElement 的 timeout 處理
            WebElement el = findElement(locator, false, waitingTime);
            if (el == null) return null;
            String t = el.getText();
            return t == null ? null : t.trim();
        }

        private String attrOrNull(By locator, String attr) {
            WebElement el = findElement(locator, false, 1000);
            if (el == null) return null;
            String v = el.getAttribute(attr);
            return v == null ? null : v.trim();
        }

        private boolean assertEquals(String label, String expected, String actual) {
            if (expected == null) return true;
            boolean eq = (actual != null) && expected.trim().equals(actual.trim());
            if (!eq) {
                logger.error(label + " 不一致，期望: [" + expected + "]，實際: [" + actual + "]");
            } else {
                logger.info(label + " 比對通過: " + expected);
            }
            return eq;
        }

        private boolean equalsIfPresent(String label, String expected, String actual) {
            if (actual == null || actual.isEmpty()) return true;
            return assertEquals(label, expected, actual);
        }
    }
