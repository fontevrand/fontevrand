	/* ===== C01：依「你提供的 XPath→值」逐一填寫，支援 select/input，自動驗證 ===== */
	private boolean fillC01ByProvidedXPaths() {
		logger.info("[C01] 依自訂 XPath 清單填寫欄位 (" + C01_CUSTOM_INPUTS.size() + " 項)");
		JavascriptExecutor js = (JavascriptExecutor) driver;

		for (Map.Entry<String, String> kv : C01_CUSTOM_INPUTS.entrySet()) {
			String xp = kv.getKey();
			String val = kv.getValue();
			if (xp == null || xp.trim().isEmpty()) continue;

			try {
				WebElement el = findElementIsDisplayed(By.xpath(xp), true, 5000);
				if (el == null) {
					logger.error("[C01] 找不到欄位: " + xp);
					return false;
				}

				String tag = el.getTagName() == null ? "" : el.getTagName().toLowerCase();
				String type = String.valueOf(el.getAttribute("type")).toLowerCase();

				if ("select".equals(tag)) {
					// 先試 value，再試文字；最後用 selectpicker JS
					boolean done = false;
					try { new Select(el).selectByValue(val); done = true; } catch (Exception ignore) {}
					if (!done) {
						try { new Select(el).selectByVisibleText(val); done = true; } catch (Exception ignore) {}
					}
					if (!done) {
						try { setBootstrapSelectValueJS(el, val); done = true; } catch (Exception ignore) {}
					}
				} else { // input/textarea…
					try { js.executeScript("arguments[0].scrollIntoView({block:'center'});", el); } catch (Exception ignore) {}
					try { el.clear(); } catch (Exception ignore) {}
					el.sendKeys(val);
				}

				try { Thread.sleep(100); } catch (InterruptedException ie) { Thread.currentThread().interrupt(); }

				// 驗證
				if ("select".equals(tag)) {
					// 若是 select，檢查當前顯示或 value 是否有值（有些用文字值）
					String curVal = el.getAttribute("value");
					String shown = getSelectedText(byOf(el));
					if ((curVal == null || curVal.isBlank()) && (shown == null || shown.isBlank())) {
						logger.error("[C01] select 設值未生效: " + xp);
						return false;
					}
				} else {
					String v = el.getAttribute("value");
					if ((v == null || v.trim().isEmpty()) && (val != null && !val.trim().isEmpty())) {
						logger.error("[C01] 欄位輸入未生效: " + xp);
						return false;
					}
				}

			} catch (Exception ex) {
				logger.error("[C01] 輸入欄位例外: " + xp + " | " + ex.getMessage());
				return false;
			}
		}

		logger.info("[C01] 自訂 XPath 欄位填寫完成。");
		return true;
	}

	/** 反推出一個可用的 By（優先 id/name；否則使用相對 XPath） */
	private By byOf(WebElement el) {
		try { String id = el.getAttribute("id"); if (id != null && !id.isBlank()) return By.id(id); } catch (Exception ignore) {}
		try { String name = el.getAttribute("name"); if (name != null && !name.isBlank()) return By.name(name); } catch (Exception ignore) {}
		return By.xpath("."); // 不會真的用到 select 元素之外
	}

