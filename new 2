		try {
			driver.switchTo().defaultContent();
			List<WebElement> iframes = driver.findElements(By.tagName("iframe"));
			for (int i = 0; i < iframes.size(); i++) {
				try {
					driver.switchTo().defaultContent();
					driver.switchTo().frame(i);
					List<WebElement> addrHeaders = driver.findElements(
						By.xpath("//*[self::th or self::label or self::div][contains(normalize-space(.), '戶籍地址')]"));
					if (!addrHeaders.isEmpty()) {
						logger.debug("[iframe] Switched into iframe index=" + i + " for C01 address.");
						return;
					}
				} catch (Exception ignore) {}
			}
		} catch (Exception ignore) {
		} finally {
			// 若沒有命中任何 iframe，保留目前 context（defaultContent）
		}
	}

	// 在給定 scope 底下（或整頁）嘗試 select visibleText
	private void selectIfPresentIn(WebElement scope, By by, String visibleText) {
		try {
			if (visibleText == null || visibleText.isBlank()) return;
			WebElement el = (scope != null) ? scope.findElement(by) : findElementIsDisplayed(by, false, 800);
			if (el != null) {
				try { new Select(el).selectByVisibleText(visibleText); } catch (Exception ignore) {}
			}
		} catch (Exception ignore) {}
	}

	// 嘗試在某範圍內找到第一個可點擊元素
	private WebElement getFirstClickable(WebElement scope, By... locators) {
		for (By b : locators) {
			try {
				WebElement el = (scope != null) ? scope.findElement(b) : findElementIsDisplayed(b, false, 800);
				if (el != null && el.isDisplayed() && el.isEnabled()) return el;
			} catch (Exception ignore) {}
		}
		return null;
	}

	// ★★ 新版：填 C01 地址變更欄位（以實際 HTML id 為主＋備援）
	private boolean fillC01_AddressChange() {
		// 1) 切到 C01（tab_1）並確保內容可見
		if (!ensureTabActiveByCode("C01")) return false;

		// 2) （若需要）切入可能承載地址欄位的 iframe
		switchIntoFrameIfNeededForAddress();
		waitGlobalMasksGone(10);

		// 3) 郵遞區號：#clientspc（優先選 110 台北市信義區；選不到就第一個有效）
		final By ZIP = By.id("clientspc");
		String zipSelected = null;
		if (findElement(ZIP, false, 800) != null) {
			zipSelected = selectByTextFromSelectOrBootstrap(ZIP, "110 台北市信義區");
			if (zipSelected == null || zipSelected.isBlank()) {
				zipSelected = selectFirstOptionFromSelectOrBootstrap(ZIP);
			}
			waitGlobalMasksGone(6);
		}

		// 4) 地址欄位：#clientAddress（備援：根據文案/placeholder）
		final By ADDR = By.id("clientAddress");
		WebElement addrEl = getFirstClickable(
			null,
			ADDR,
			By.xpath("//input[@name='clientAddress' or contains(@placeholder,'戶籍地址')]"),
			By.xpath("//label[contains(normalize-space(),'戶籍地址')]/following::*[self::input or self::textarea][1]")
		);
		if (addrEl == null) {
			logger.error("[C01] 找不到『戶籍地址』欄位（#clientAddress 或備援定位器），請檢查 DOM。");
			driver.switchTo().defaultContent();
			return false;
		}

		// 若為 readonly，先解除（測試自動化限定）
		try { ((JavascriptExecutor)driver).executeScript("arguments[0].removeAttribute('readonly');", addrEl); } catch (Exception ignore) {}
		try { ((JavascriptExecutor)driver).executeScript("arguments[0].scrollIntoView({block:'center'});", addrEl); } catch (Exception ignore) {}

		final String NEW_ADDRESS = "松壽路3號";
		try { addrEl.clear(); } catch (Exception ignore) {}
		input(addrEl, NEW_ADDRESS);

		// 5) 住家電話：clientHomePhoneCde + clientHomePhone
		WebElement homeCde = findElementIsDisplayed(By.id("clientHomePhoneCde"), false, 800);
		WebElement homeNum = findElementIsDisplayed(By.id("clientHomePhone"),    false, 800);
		if (homeCde != null) { try { homeCde.clear(); } catch (Exception ignore) {} input(homeCde, "02"); }
		if (homeNum != null) { try { homeNum.clear(); } catch (Exception ignore) {} input(homeNum, "77218888"); }

		// 6) 公司電話：clientOfficePhoneCde + clientOfficePhone + clientOfficePhone2(分機)
		WebElement offCde = findElementIsDisplayed(By.id("clientOfficePhoneCde"), false, 800);
		WebElement offNum = findElementIsDisplayed(By.id("clientOfficePhone"),    false, 800);
		WebElement offExt = findElementIsDisplayed(By.id("clientOfficePhone2"),   false, 800);
		if (offCde != null) { try { offCde.clear(); } catch (Exception ignore) {} input(offCde, "02"); }
		if (offNum != null) { try { offNum.clear(); } catch (Exception ignore) {} input(offNum, "23945678"); }
		if (offExt != null) { try { offExt.clear(); } catch (Exception ignore) {} input(offExt, "1234"); }

		// 7) 校驗地址確實帶值
		String addrVal = "";
		try { addrVal = addrEl.getAttribute("value"); } catch (Exception ignore) {}
		if (addrVal == null || !normalizeText(addrVal).contains(normalizeText(NEW_ADDRESS))) {
			logger.error("[C01] 地址輸入後回讀驗證失敗，實際值=" + addrVal);
			driver.switchTo().defaultContent();
			return false;
		}

		driver.switchTo().defaultContent();
		logger.info("[C01] 地址變更欄位填寫完成（郵遞區號/地址/住家電話/公司電話），zip=" + zipSelected);
		return true;
	}

	// 清空並輸入
	private void clearAndType(WebElement el, String text) {
		try {
			el.sendKeys(Keys.chord(Keys.CONTROL, "a"), Keys.DELETE);
		} catch (Exception ignore) {}
		input(el, text);
	}

	// 按「申請完成-預覽異動內容」並寬鬆確認 Step3
	private boolean clickReviewAndVerifyStep3() {
		WebElement reviewBtn = findElementIsDisplayed(reviewButtonId, true, 2500);
		if (reviewBtn == null) reviewBtn = findElementIsDisplayed(reviewButtonXPath, true, 2500);
		if (reviewBtn == null) {
			logger.error("[Step2->Step3] 找不到『申請完成-預覽異動內容』按鈕");
			return false;
		}
		click(reviewBtn, true);
		waitGlobalMasksGone(8);
		waitForStable();

		// 寬鬆驗證 Step3：「任一已知錨點」存在即可
		boolean step3Reachable =
			   findElement(By.id("loanData3"), false, 1500) != null
			|| findElement(By.id("tdTtransfer"), false, 1500) != null
			|| findElement(By.id("tddoc"), false, 1500) != null
			|| findElement(By.tagName("body"), false, 1500) != null;

		if (!step3Reachable) {
			logger.warn("[Step3] 未捕捉到既有錨點，但已嘗試寬鬆驗證；繼續後續流程。");
		}
		return true;
	}
