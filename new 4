	/* =========================================================
	  保單變更：全選 → 紅字剔除 → 進 Step2 → 分派驗證（含策略B）
	  ========================================================= */
	private boolean runPolicyChange_AllSelect_FilterAndEnterStep2() {
		// 回到 Step1 時再保險地把保單打勾
		if (!ensureChecked(By.id("checkbox" + POLICY_NO), By.xpath(policyChangeCheckboxLocator), 6000)) return false;

		// 選「保單變更」radio
		WebElement pcRadio = findElementIsDisplayed(policyChangeRadio, true, 4000);
		if (pcRadio == null) return false;
		safeClick(pcRadio);
		waitForStable();

		// 等待各項變更的 checkbox 出現（例如 C01）
		if (findElement(By.xpath("//label[@for='C01']"), false, 3000) == null) {
			waitForStable();
		}

		// 進入全選前，快照「原本就勾選」的集合（供策略B保底）
		originallyCheckedPolicyChangeCodes = getCheckedPolicyChangeCodes();

		// 全選所有 Cxx/Axx（但等下會反勾你要求 skip 的）
		selectAllPolicyChangeCheckboxes(/*alsoClearFirst=*/true);

		// 依需求：Step1 預先取消 C02（收費管道變更）、A16（附約保障異動）
		for (String skip : STEP1_SKIP_CODES) {
			deselectPolicyChangeByCode(skip);
		}

		// 先按下一步讓紅字浮現（若有）
		WebElement next = findElementIsDisplayed(By.xpath(stepOneNextButtonLocator), true, 4000);
		if (next == null) return false;
		safeClick(next);
		waitForStable();

		// 最多 3 輪：解析紅字 → 取消不允辦理 → 再按下一步
		for (int round = 1; round <= 3; round++) {
			String errText = tryGetText(policyChangeErrMeg);
			String normalizedErr = normalizeText(errText);
			boolean hasErr = errText != null && !normalizedErr.isEmpty();

			// 沒紅字 → 直接到 Step2（依「已維護的 selectedCodes」確立 allowed）
			if (!hasErr) {
				if (!selectedCodes.isEmpty()) {
					allowedPolicyChangeCodes = new ArrayList<>(selectedCodes);
				} else {
					allowedPolicyChangeCodes = fallbackCodesWhenNoError();
				}
				// 過濾掉你指定要 skip 的代碼
				allowedPolicyChangeCodes = allowedPolicyChangeCodes.stream()
					.filter(c -> !STEP1_SKIP_CODES.contains(c)).collect(Collectors.toList());

				logger.debug("[PolicyChange] 進 Step2，允許項目=" + allowedPolicyChangeCodes);
				return true;
			}

			// 特例：提示未勾選 → 重新勾選再試
			if (normalizedErr.contains("變更項目清單未勾選") || normalizedErr.contains("請選擇變更項目")) {
				selectAllPolicyChangeCheckboxes(/*alsoClearFirst=*/false);
				for (String skip : STEP1_SKIP_CODES) deselectPolicyChangeByCode(skip);
				WebElement nextRetry = findElementIsDisplayed(By.xpath(stepOneNextButtonLocator), true, 4000);
				if (nextRetry == null) return false;
				safeClick(nextRetry);
				waitForStable();
				continue;
			}

			// 有紅字：解析出對應要反勾的代碼
			Set<String> toUncheck = parsePolicyChangeErrorToCodes(errText);

			// 解析不到任何代碼 → 不直接失敗，保留原本勾選（策略B）
			if (toUncheck.isEmpty()) {
				allowedPolicyChangeCodes = fallbackCodesWhenNoError();
				allowedPolicyChangeCodes = allowedPolicyChangeCodes.stream()
					.filter(c -> !STEP1_SKIP_CODES.contains(c)).collect(Collectors.toList());
				return true;
			}

			for (String code : toUncheck) deselectPolicyChangeByCode(code);

			// 若全被反勾了 → 策略B
			List<String> stillChecked = getCheckedPolicyChangeCodes();
			if (stillChecked.isEmpty()) {
				allowedPolicyChangeCodes = fallbackCodesWhenNoError();
				allowedPolicyChangeCodes = allowedPolicyChangeCodes.stream()
					.filter(c -> !STEP1_SKIP_CODES.contains(c)).collect(Collectors.toList());
				return true;
			}

			// ★ 將帶入 Step2 的允許清單
			allowedPolicyChangeCodes = new ArrayList<>(stillChecked);
			allowedPolicyChangeCodes = allowedPolicyChangeCodes.stream()
				.filter(c -> !STEP1_SKIP_CODES.contains(c)).collect(Collectors.toList());
			logger.debug("[PolicyChange] 準備進 Step2 的允許清單: " + allowedPolicyChangeCodes);

			// 再按下一步
			WebElement next2 = findElementIsDisplayed(By.xpath(stepOneNextButtonLocator), true, 4000);
			if (next2 == null) return false;
			safeClick(next2);
			waitForStable();

			// 到這裡通常就會進 Step2，結束流程
			return true;
		}

		// 超過重試仍有紅字 → 策略B保底
		String lastErr = tryGetText(policyChangeErrMeg);
		if (lastErr != null && !normalizeText(lastErr).isEmpty()) {
			allowedPolicyChangeCodes = fallbackCodesWhenNoError();
			allowedPolicyChangeCodes = allowedPolicyChangeCodes.stream()
				.filter(c -> !STEP1_SKIP_CODES.contains(c)).collect(Collectors.toList());
			return true;
		}

		// 正常情況（理論上走不到）
		allowedPolicyChangeCodes = getCheckedPolicyChangeCodes();
		if (allowedPolicyChangeCodes.isEmpty()) {
			allowedPolicyChangeCodes = fallbackCodesWhenNoError();
		}
		allowedPolicyChangeCodes = allowedPolicyChangeCodes.stream()
			.filter(c -> !STEP1_SKIP_CODES.contains(c)).collect(Collectors.toList());
		return true;
	}

	/** 「沒有 errormeg」或「解析不到代碼」時的保底清單（A / B） */
	private List<String> fallbackCodesWhenNoError() {
		List<String> all = getAllPolicyChangeCodes();
		// 優先使用 selectedCodes（跨 Step 可用）
		if (!selectedCodes.isEmpty()) return new ArrayList<>(selectedCodes);

		// 退而求其次：當前頁面仍能抓到者
		List<String> currentChecked = getCheckedPolicyChangeCodes();
		if (!currentChecked.isEmpty()) return currentChecked;

		// 策略 B：保留原本使用者勾選；若無，保 C01；再不行用全清單
		if ("B".equalsIgnoreCase(NO_ERROR_FALLBACK_STRATEGY)) {
			if (originallyCheckedPolicyChangeCodes != null && !originallyCheckedPolicyChangeCodes.isEmpty()) {
				return new ArrayList<>(originallyCheckedPolicyChangeCodes);
			}
			if (all.contains("C01")) return Arrays.asList("C01");
			return all;
		}

		// 策略 A：視為全選都允許
		return all;
	}

	/** 取得 Step1 可見的所有 Cxx/Axx 代碼 */
	private List<String> getAllPolicyChangeCodes() {
		try {
			List<WebElement> inputs = findElements(
				By.xpath("//input[@type='checkbox' and string-length(@id)=3 and (starts-with(@id,'C') or starts-with(@id,'A'))]"),
