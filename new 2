	  勾/反勾：保單變更 Cxx/Axx
	  ========================= */

	// （反勾/個別補勾）超穩定勾/反勾：優先點 label → 點 input → 最後 JS 強制 + 事件，並驗證狀態
	private void setPolicyChangeChecked(String code, boolean checked) {
		if (code == null || !code.matches("^[CA]\\d{2}$")) return;

		final JavascriptExecutor js = (JavascriptExecutor) driver;
		final By inputBy = By.id(code);
		final By labelBy = By.xpath("//label[@for='" + code + "']");

		// 讀取目前狀態的 helper
		java.util.function.Supplier<Boolean> readState = () -> {
			try {
				WebElement in = findElement(inputBy, false, 250);
				if (in != null) {
					try { return in.isSelected(); }
					catch (Exception ignore) {}
					String aria = String.valueOf(in.getAttribute("checked"));
					if ("true".equalsIgnoreCase(aria)) return true;
					if ("checked".equalsIgnoreCase(aria)) return true;
				}
			} catch (Exception ignore) {}
			try {
				WebElement lb = findElement(labelBy, false, 200);
				if (lb != null) {
					String cls = String.valueOf(lb.getAttribute("class"));
					if (cls.contains("active") || cls.contains("checked")) return true;
					String aria = String.valueOf(lb.getAttribute("aria-checked"));
					if ("true".equalsIgnoreCase(aria)) return true;
				}
			} catch (Exception ignore) {}
			return false;
		};

		Boolean now = readState.get();
		if (now != null && now == checked) return;

		for (int attempt = 1; attempt <= 4; attempt++) {
			try {
				WebElement input = findElement(inputBy, false, 400);
				WebElement label = findElement(labelBy, false, 400);

				// 1) 優先點 label
				if (label != null) {
					try { js.executeScript("arguments[0].scrollIntoView({block:'center'});", label); } catch (Exception ignore) {}
					try { label.click(); } catch (Exception e) { js.executeScript("arguments[0].click();", label); }
				} else if (input != null && input.isDisplayed()) {
					// 2) 點 input
					try { js.executeScript("arguments[0].scrollIntoView({block:'center'});", input); } catch (Exception ignore) {}
					try { input.click(); } catch (Exception e) { js.executeScript("arguments[0].click();", input); }
				}

				try { Thread.sleep(160); } catch (InterruptedException ie) { Thread.currentThread().interrupt(); }

				// 若狀態還不對，最後用 JS 強制 + 事件
				if (readState.get() != checked) {
					if (input == null) input = findElement(inputBy, false, 300);
					if (input != null) {
						js.executeScript(
							"arguments[0].checked = arguments[1];" +
							"arguments[0].dispatchEvent(new Event('input', {bubbles:true}));" +
							"arguments[0].dispatchEvent(new Event('change', {bubbles:true}));" +
							"arguments[0].dispatchEvent(new Event('click', {bubbles:true}));",
							input, checked
						);
					}
					if (label != null) {
						if (checked) {
							js.executeScript(
								"arguments[0].classList.add('active');" +
								"arguments[0].classList.add('checked');" +
								"arguments[0].setAttribute('aria-checked','true');",
								label
							);
						} else {
							js.executeScript(
								"arguments[0].classList.remove('active');" +
								"arguments[0].classList.remove('checked');" +
								"arguments[0].setAttribute('aria-checked','false');",
								label
							);
						}
					}
				}

				try { Thread.sleep(140); } catch (InterruptedException ie) { Thread.currentThread().interrupt(); }
				if (readState.get() == checked) return;

			} catch (org.openqa.selenium.StaleElementReferenceException stale) {
				// 重試
			} catch (Exception e) {
				if (attempt >= 4) logger.warn("setPolicyChangeChecked failed for " + code + ": " + e.getMessage());
			}
		}
	}

